#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Lima names the guest user after the *host* user (not a fixed "lima"
# account). agentcage invokes limactl as that same user, so the host
# username is the guest username and is templated in here at config
# generation — Lima 2.x warns against reading its cidata env vars from
# provisioning scripts.
lima_user="{{ lima_user }}"

# Install Podman and dependencies.
# --no-install-recommends keeps the install lean: Ubuntu's `podman` recommends
# pull in mail-transport-agent + assorted extras that ~50 MB on a fresh image
# and nothing in agentcage uses. `socat` was previously in this list but is
# not referenced anywhere in the agentcage codebase — dropped.
apt-get update -qq
apt-get install -y -qq --no-install-recommends \
    podman fuse-overlayfs uidmap slirp4netns iptables

# Configure Podman storage
mkdir -p /etc/containers
cat > /etc/containers/storage.conf <<'STOR'
[storage]
driver = "overlay"
[storage.options.overlay]
mount_program = "/usr/bin/fuse-overlayfs"
STOR

# Allow unprivileged processes to bind ports >= 80 (needed for proxy reverse mode).
# Setting to 80 instead of 0 blocks binding sensitive low ports (1-79, incl. SSH 22, DNS 53).
sysctl -w net.ipv4.ip_unprivileged_port_start=80
echo "net.ipv4.ip_unprivileged_port_start=80" > /etc/sysctl.d/99-agentcage.conf

# Allow the cage user to read journald logs (needed for podman logs + agentcage cage logs)
usermod -aG systemd-journal "$lima_user" || true
usermod -aG adm "$lima_user" || true

# Ensure journal files are group-readable for systemd-journal members (least privilege)
mkdir -p /var/log/journal
systemd-tmpfiles --create --prefix /var/log/journal
chmod -R g+rX /var/log/journal

# Enable lingering for the cage user so systemd user services persist.
# Touch the sentinel file directly rather than running
# `loginctl enable-linger`: the latter goes through systemd-logind over
# D-Bus, and during cloud-init that call has been observed to deadlock
# (the preceding `usermod -aG` on the user who already has an active
# SSH session leaves logind unresponsive — its dbus calls then time out
# at 25 s). Once wedged, every subsequent ssh login fails with
# `pam_systemd: Failed to create session: Connection timed out`, which
# wedges the entire agentcage flow. The sentinel file is logind's own
# state, so writing it has the same effect without round-tripping dbus.
mkdir -p /var/lib/systemd/linger
touch "/var/lib/systemd/linger/$lima_user"

echo "agentcage provisioning complete"
