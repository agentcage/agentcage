# Lima VM config for agentcage cage: {{ name }}
vmType: {{ vm_type }}
{% if vm_type == "vz" %}
rosetta:
  enabled: false
mountType: virtiofs
{% endif %}

images:
  # Pinned to an immutable dated path. The .../release/ symlink is mutable —
  # Ubuntu republishes the 24.04 point release in place, which changes the
  # image bytes and makes the digest check below fail fatally. Bump the
  # release-YYYYMMDD path and BOTH digests together to update.
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release-20260321/ubuntu-24.04-server-cloudimg-amd64.img"
    arch: "x86_64"
    digest: "sha256:5c3ddb00f60bc455dac0862fabe9d8bacec46c33ac1751143c5c3683404b110d"
  - location: "https://cloud-images.ubuntu.com/releases/24.04/release-20260321/ubuntu-24.04-server-cloudimg-arm64.img"
    arch: "aarch64"
    digest: "sha256:1ea801e659d2f5035ac294e0faab0aac9b6ba66753df933ba5c7beab0c689bd0"

cpus: {{ vcpus }}
memory: "{{ mem_gb }}GiB"
disk: "20GiB"

mounts:
  # Security: only mount the specific directories the VM needs, instead of
  # the entire home directory.  This prevents the VM from accessing ~/.ssh,
  # ~/.gnupg, ~/.aws, and other sensitive host files.
  - location: "~/.config/agentcage"
    writable: false
  - location: "~/.local/share/agentcage"
    writable: true
{% for extra_mount in extra_mounts %}
  - location: "{{ extra_mount.location }}"
    writable: {{ extra_mount.writable | lower }}
{% endfor %}
  - location: "/tmp/lima"
    writable: true

containerd:
  system: false
  user: false

provision:
  - mode: system
    script: |
{{ provision_script | indent(6, first=true) }}

{% if port_forwards %}
portForwards:
{% for pf in port_forwards %}
  - guestPort: {{ pf.guest_port }}
    hostPort: {{ pf.host_port }}
    hostIP: "{{ pf.host_bind }}"
{% endfor %}
{% endif %}
