# Lima VM config for agentcage cage: {{ name }}
vmType: {{ vm_type }}
{% if vm_type == "vz" %}
rosetta:
  enabled: false
mountType: virtiofs
{% endif %}

images:
  # Debian 13 "trixie" genericcloud. Trixie's apt repos ship podman 5.x with
  # netavark as a hard dependency (and aardvark-dns alongside), so the vm
  # backend gets the netavark/aardvark stack that agentcage's transparent
  # host-tracking DNS requires — Ubuntu 24.04 only had podman 4.9 + CNI.
  #
  # Pinned to an immutable dated build dir. The .../latest/ symlink and the
  # .../daily/ tree are mutable — Debian rotates/prunes dated dirs (≈weekly)
  # and republishes 'latest' in place, which changes the image bytes and
  # makes the digest check below fail fatally. Bump the YYYYMMDD-NNNN path and
  # BOTH digests together to update. Debian publishes ONLY SHA512SUMS per
  # dated dir (no SHA256SUMS), so these are sha512 digests (Lima supports it).
  - location: "https://cloud.debian.org/images/cloud/trixie/20260601-2496/debian-13-genericcloud-amd64-20260601-2496.qcow2"
    arch: "x86_64"
    digest: "sha512:61264ae6968d765e61cf5607a664ba63099ddfb66b8404aa737d06f89b39c8e0fbaa1517b13705909ff01686d32015a0147436662672b4dacc10b4a171d7993d"
  - location: "https://cloud.debian.org/images/cloud/trixie/20260601-2496/debian-13-genericcloud-arm64-20260601-2496.qcow2"
    arch: "aarch64"
    digest: "sha512:d49b15db1d53aab1cb1ba36af119e6851933fdf33e64124bc3aae0677b7219658f237019bfe9db61a95b11d99e068e8554c6c3df08d46540e8e263f72dc5d1ab"

cpus: {{ vcpus }}
memory: "{{ mem_gb }}GiB"
disk: "20GiB"

mounts:
  # Security: only mount the specific directories the VM needs, instead of
  # the entire home directory.  This prevents the VM from accessing ~/.ssh,
  # ~/.gnupg, ~/.aws, and other sensitive host files.
  - location: "~/.config/agentcage"
    writable: false
  - location: "~/.local/share/agentcage"
    writable: true
{% for extra_mount in extra_mounts %}
  - location: "{{ extra_mount.location }}"
    writable: {{ extra_mount.writable | lower }}
{% endfor %}

containerd:
  system: false
  user: false

provision:
  - mode: system
    script: |
{{ provision_script | indent(6, first=true) }}

{% if port_forwards %}
portForwards:
{% for pf in port_forwards %}
  - guestPort: {{ pf.guest_port }}
    hostPort: {{ pf.host_port }}
    hostIP: "{{ pf.host_bind }}"
{% endfor %}
{% endif %}
