[Unit]
Description=agentcage cage
Requires={{ name }}-egress.service
After={{ name }}-egress.service

[Container]
ContainerName={{ name }}-cage
Image={{ image }}
Network={{ name }}-net.network:ip={{ ip_cage }}
Environment="HTTP_PROXY=http://{{ ip_egress }}:8080"
Environment="HTTPS_PROXY=http://{{ ip_egress }}:8080"
Environment="http_proxy=http://{{ ip_egress }}:8080"
Environment="https_proxy=http://{{ ip_egress }}:8080"
Environment="NODE_EXTRA_CA_CERTS=/certs/mitmproxy-ca-cert.pem"
Environment="SSL_CERT_FILE=/certs/mitmproxy-ca-cert.pem"
Environment="AGENTCAGE_VERSION={{ agentcage_version }}"
Volume={{ name }}-public-certs.volume:/certs:ro,Z
{# NOTE: do NOT reintroduce a broad `Volume={{ patches_host_dir }}:/agentcage`
   bind here. That mount used to expose every sibling cage's resolv-<name>.conf
   inside this cage (cage name + DNS sidecar IP — any cage could `ls /agentcage/`
   to enumerate its host neighbours). The runtime only needs the cage's own
   resolv.conf (mounted at /etc/resolv.conf on the next line) and, in
   nested-containers mode, the specific files under <patches_host_dir>/nested/
   mounted at fixed cage paths below (/etc/containers, /usr/local/bin/docker).
   No cage-side /agentcage/ directory is required. #}
Volume={{ patches_host_dir }}/resolv-{{ name }}.conf:/etc/resolv.conf:ro,Z
{% for vol in volumes %}
Volume={{ vol }}
{% endfor %}
{% for vol_name, mount in named_volumes.items() %}
Volume={{ vol_name }}:{{ mount }}
{% endfor %}
{% for spec in tmpfs %}
Tmpfs={{ spec }}
{% endfor %}
{% for secret in podman_secrets %}
{% if deploy_name %}
Secret={{ deploy_name }}.{{ secret }},type=env,target={{ secret }}
{% else %}
Secret={{ secret }},type=env
{% endif %}
{% endfor %}
{% for key, val in env.items() %}
Environment="{{ key }}={{ val }}"
{% endfor %}
{% if placeholders_env_path %}
{# Secret-injection placeholders. An EnvironmentFile (not baked
   Environment= lines) so podman re-reads it at every container creation:
   a plain `cage restart` picks up placeholder changes without a quadlet
   regeneration. The parent dir is also mounted for in-cage consumers
   (shells can source /run/agentcage/env/placeholders.env). Placeholders
   are decoy tokens — never sensitive. #}
EnvironmentFile={{ placeholders_env_path }}
Volume={{ cage_env_dir }}:/run/agentcage/env:ro,Z
{% endif %}
{% if userns %}
UserNS={{ userns }}
{% endif %}
{% if user %}
User={{ user }}
{% endif %}
{% if read_only %}
ReadOnly=true
{% endif %}
{% if security_label_disable %}
SecurityLabelDisable=true
{% endif %}
{% if no_new_privileges %}
NoNewPrivileges=true
{% endif %}
{% for cap in drop_capabilities %}
DropCapability={{ cap }}
{% endfor %}
{% for cap in add_capabilities %}
AddCapability={{ cap }}
{% endfor %}
{% if nested_containers %}
AddDevice=/dev/fuse
Environment="CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf"
PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--security-opt unmask=ALL
Volume={{ name }}-podman-storage.volume:/var/lib/containers:rw
Volume={{ patches_host_dir }}/nested/docker:/usr/local/bin/docker:ro,Z
Volume={{ patches_host_dir }}/nested/storage.conf:/etc/containers/storage.conf:ro,Z
Volume={{ patches_host_dir }}/nested/containers.conf:/etc/containers/containers.conf:ro,Z
Volume={{ patches_host_dir }}/nested/registries.conf:/etc/containers/registries.conf:ro,Z
Tmpfs=/run:rw,exec,size=256M,mode=1777
{% endif %}
{% if memory %}
PodmanArgs=--memory={{ memory }}
{% endif %}
{% if cpus %}
PodmanArgs=--cpus={{ cpus }}
{% endif %}
{% if command %}
Exec={{ command | systemd_exec }}
{% endif %}

[Service]
{% if non_persistent_runtime_root %}
# Reset stale overlay state before every start (including recovery after an
# unclean stop), then remove it again once the container has stopped.
ExecStartPre=/bin/bash -c 'rm -rf {{ non_persistent_runtime_root }}{% if non_persistent_precreate_dirs %} && mkdir -p{% for dir in non_persistent_precreate_dirs %} {{ dir }}{% endfor %}{% endif %}'
ExecStopPost=/bin/bash -c 'rm -rf {{ non_persistent_runtime_root }}'
{% endif %}
{% for copy in non_persistent_file_copies %}
ExecStartPre=/bin/bash -c 'mkdir -p {{ copy.dir }} && cp -f {{ copy.src }} {{ copy.dst }}'
{% endfor %}
{% for mask in mask_mountpoints %}
# tmpfs masks (#170/#173) whose target lives under a host bind-mount force the
# OCI runtime to create the mount point, and a bind shares inodes with its
# source, so the mkdir lands in the operator's project directory on the host —
# a non-git project gains a stray `.git/hooks/` that `test -d .git` misreads as
# a repository (#320). The masks stay unconditional; instead, record here which
# of those paths were absent immediately before start, then remove exactly
# those on teardown and only while they are still empty. Host paths are
# base64-encoded because a systemd Exec line applies its own quoting before
# bash does, and no single escaping of `~/My Project` survives both layers.
ExecStartPre=/bin/bash -c 'mkdir -p {{ mask.state_dir }} && : > {{ mask.state_file }} && echo {{ mask.dirs_b64 }} | base64 -d | while IFS= read -r d; do [ -n "$d" ] || continue; [ -e "$d" ] && continue; [ -L "$d" ] && continue; echo "$d" >> {{ mask.state_file }}; done'
# Deepest path first, so `<project>/.git/hooks` is retired before the
# `<project>/.git` parent the same mask created. `rmdir` is the whole safety
# story for "only if empty"; the realpath containment check keeps a symlink
# swapped in after start from redirecting a removal outside the bind root, and
# never-recorded (pre-existing) directories are simply not in the list.
ExecStopPost=-/bin/bash -c 'f={{ mask.state_file }}; [ -f "$f" ] || exit 0; root=$(echo {{ mask.root_b64 }} | base64 -d) && root=$(realpath -m -- "$root") || exit 0; while IFS= read -r d; do [ -n "$d" ] || continue; case "$(realpath -m -- "$d")" in "$root"/*) ;; *) continue ;; esac; [ -L "$d" ] && continue; [ -d "$d" ] || continue; rmdir "$d" 2>/dev/null || echo "agentcage: keeping $d (created as a tmpfs mask mount point, but not empty)" >&2; done < "$f"; rm -f "$f"; exit 0'
{% endfor %}
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do podman exec {{ name }}-egress test -f /home/acproxy/.mitmproxy/mitmproxy-ca-cert.pem && exit 0; sleep 1; done; echo "Timed out waiting for CA cert"; exit 1'
# Add the cage's default route via the egress container. Retries because
# the container PID is briefly invalid (0/empty) right after `podman start`
# returns and before the container's init has fully populated state.
# Without the retry, the route is silently skipped on a restart, the
# cage has no outbound network, and every fetch from inside the cage
# fails fast with ECONNREFUSED — surfacing as 502s in tests that
# exercise the data path after a domain add or secret set restart.
ExecStartPost=/bin/sh -c 'LAST_ERR=""; for i in $(seq 1 30); do PID=$(podman inspect --format "{{"{{"}}.State.Pid{{"}}"}}" {{ name }}-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then LAST_ERR=$(nsenter -t "$PID" -U -n -- ip route replace default via {{ ip_egress }} 2>&1) && { echo "added default route via {{ ip_egress }} (attempt $i)"; exit 0; }; fi; sleep 0.5; done; echo "WARNING: failed to add cage default route via {{ ip_egress }} after 30 attempts: $LAST_ERR" >&2; exit 1'
Restart={{ restart }}
RestartSec={{ restart_sec }}
{% if timeout_start_sec %}
TimeoutStartSec={{ timeout_start_sec }}
{% endif %}
{% if timeout_stop_sec %}
TimeoutStopSec={{ timeout_stop_sec }}
{% endif %}

[Install]
{% if lifecycle == "service" %}
WantedBy=default.target
{% endif %}
