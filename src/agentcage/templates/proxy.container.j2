[Unit]
Description=agentcage mitmproxy
# Wants= (not Requires=) so a dns restart — domain add/rm flush, dnsmasq
# config update — does NOT cascade-stop the proxy. After= keeps boot-time
# ordering: proxy starts after dns. If dns is down while the proxy is
# running, hostname lookups fail with NXDOMAIN; the proxy stays up and
# resumes when dns comes back.
Wants={{ name }}-dns.service
After={{ name }}-dns.service

[Container]
ContainerName={{ name }}-proxy
Image=localhost/agentcage-proxy
Network={{ name }}-net.network:ip={{ ip_proxy }}
Network=podman
{% for srv in dns_servers %}
DNS={{ srv }}
{% endfor %}
Volume={{ config_host_path }}:/etc/agentcage/config.yaml:ro,Z
Environment="PYTHONUNBUFFERED=1"
Volume={{ name }}-certs.volume:/home/mitmproxy/.mitmproxy:Z
{% if capture_enabled %}
Volume={{ capture_host_dir }}:/var/log/agentcage/capture:Z
Environment="AGENTCAGE_CAPTURE=/var/log/agentcage/capture/capture.jsonl"
{% endif %}
AddCapability=NET_ADMIN
Sysctl=net.ipv4.ip_unprivileged_port_start=80
{% if inbound_forwards %}
Exec=mitmdump -s /app/addon.py --mode regular@{{ ip_proxy }}:8080 --mode transparent@8443{% for fwd in inbound_forwards %} --mode reverse:http://{{ ip_cage }}:{{ fwd.container_port }}@0.0.0.0:{{ fwd.container_port }}{% endfor %} --set connection_strategy=lazy --set keep_host_header=true{% if not log_proxy_connections %} --set flow_detail=0{% endif %}{% if passthrough_regex %} --ignore-hosts "{{ passthrough_regex }}"{% endif %}

{% for fwd in inbound_forwards %}
PublishPort={{ fwd.publish_spec }}
{% endfor %}
{% else %}
Exec=mitmdump -s /app/addon.py --mode regular@{{ ip_proxy }}:8080 --mode transparent@8443 --set connection_strategy=lazy{% if not log_proxy_connections %} --set flow_detail=0{% endif %}{% if passthrough_regex %} --ignore-hosts "{{ passthrough_regex }}"{% endif %}

{% endif %}
{% for secret in proxy_secrets %}
{% if deploy_name %}
Secret={{ deploy_name }}.{{ secret }},type=env,target={{ secret }}
{% else %}
Secret={{ secret }},type=env
{% endif %}
{% endfor %}

[Service]
{% for cred in creds_secrets %}
ExecStartPre=/bin/bash -o pipefail -c 'podman secret rm "{{ deploy_name }}.{{ cred }}" 2>/dev/null || true; systemd-creds decrypt "{{ creds_dir }}/{{ cred }}.cred" - | podman secret create "{{ deploy_name }}.{{ cred }}" -'
{% endfor %}
ExecStartPre=/bin/bash -c 'mp=$(podman volume inspect agentcage-certs-{{ name }} --format "{{"{{"}}.Mountpoint{{"}}"}}") && {% if rootless %}podman unshare chown{% else %}chown{% endif %} 1000:1000 "$mp"'
{% if capture_enabled %}
ExecStartPre=/bin/bash -c '{% if rootless %}podman unshare chown 1000:1000 "{{ capture_host_dir }}" 2>/dev/null || chmod 1777 "{{ capture_host_dir }}"{% else %}chown 1000:1000 "{{ capture_host_dir }}"{% endif %}'
{% endif %}
ExecStartPost=/usr/bin/podman exec --user root {{ name }}-proxy sh -c "printf '{% for srv in dns_servers %}nameserver {{ srv }}\n{% endfor %}' > /etc/resolv.conf"
{% if inspected_tcp_ports %}
ExecStartPost=/usr/bin/podman exec --user root {{ name }}-proxy sh -c "{% for port in inspected_tcp_ports %}iptables -t nat -A PREROUTING -p tcp --dport {{ port }} -j REDIRECT --to-port 8443{% if not loop.last %} && {% endif %}{% endfor %}"
{% endif %}
ExecStartPost=/usr/bin/podman exec --user root {{ name }}-proxy sh -c "iptables -P FORWARD DROP && iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT && iptables -A FORWARD -p icmp --icmp-type echo-request -j ACCEPT{% for port in passthrough_tcp_ports %} && iptables -A FORWARD -p tcp --dport {{ port }} -j ACCEPT{% endfor %}{% for port in allow_udp_ports %} && iptables -A FORWARD -p udp --dport {{ port }} -j ACCEPT{% endfor %}"
ExecStartPost=/usr/bin/podman exec --user root {{ name }}-proxy sh -c "ip6tables -P FORWARD DROP"
Restart=on-failure

[Install]
WantedBy=default.target
