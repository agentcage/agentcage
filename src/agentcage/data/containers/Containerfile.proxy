# update-from: docker.io/mitmproxy/mitmproxy:latest
FROM docker.io/mitmproxy/mitmproxy@sha256:743b6cdc817211d64bc269f5defacca8d14e76e647fc474e5c7244dbcb645141
# pyyaml: addon config. cryptography: secret_injection google-jwt-bearer
# transform signs JWTs. mitmproxy already pulls cryptography transitively
# but we pin it explicitly so the proxy doesn't silently rely on that.
RUN pip install --no-cache-dir pyyaml==6.0.3 'cryptography>=41'
COPY proxy/inspectors/ /app/inspectors/
COPY proxy/transforms/ /app/transforms/
COPY proxy/relays/ /app/relays/
COPY proxy/addon.py /app/addon.py
COPY proxy/capture.py /app/capture.py
COPY proxy/secret_injector.py /app/secret_injector.py
ENV AGENTCAGE_CONFIG=/etc/agentcage/config.yaml
ENV PYTHONUNBUFFERED=1
# The upstream mitmproxy image owns /home/mitmproxy as root:root mode 700 and
# ships a custom entrypoint that chowns it at runtime (which fails under
# rootless Podman).  We bypass the entrypoint and make the home dir traversable
# so the mitmproxy user (UID 1000) can access the cert volume at .mitmproxy/.
# The iptables package on Debian (used by the upstream mitmproxy image)
# installs both `iptables` and `ip6tables` binaries via the iptables-nft /
# iptables-legacy alternatives. proxy.container.j2's ExecStartPost relies
# on `ip6tables -P FORWARD DROP` as a v6 forwarding failsafe; if the base
# image is ever changed to one that doesn't ship ip6tables (some
# distroless or alpine variants), add it explicitly here.
RUN apt-get update && apt-get install -y --no-install-recommends iptables && rm -rf /var/lib/apt/lists/*
RUN chmod 755 /home/mitmproxy
ENTRYPOINT []
USER mitmproxy
CMD ["mitmdump", "-s", "/app/addon.py", "--listen-port", "8080", \
     "--set", "connection_strategy=lazy", \
     "--set", "flow_detail=0"]
