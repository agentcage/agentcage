# update-from: docker.io/mitmproxy/mitmproxy:latest
FROM docker.io/mitmproxy/mitmproxy@sha256:743b6cdc817211d64bc269f5defacca8d14e76e647fc474e5c7244dbcb645141
RUN pip install --no-cache-dir pyyaml==6.0.3
COPY proxy/inspectors/ /app/inspectors/
COPY proxy/addon.py /app/addon.py
COPY proxy/capture.py /app/capture.py
COPY proxy/secret_injector.py /app/secret_injector.py
ENV AGENTCAGE_CONFIG=/etc/agentcage/config.yaml
ENV PYTHONUNBUFFERED=1
# The upstream image sets /home/mitmproxy to root:root 700.  We bypass the
# default entrypoint (it uses stat/usermod that fail under rootless podman),
# so fix ownership here so the mitmproxy user can access its home dir.
RUN chmod 755 /home/mitmproxy
ENTRYPOINT []
USER mitmproxy
CMD ["mitmdump", "-s", "/app/addon.py", "--listen-port", "8080", \
     "--set", "connection_strategy=lazy", "--listen-host", "10.89.0.11", \
     "--set", "flow_detail=0"]
