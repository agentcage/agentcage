# agentcage-egress: the per-cage egress image, the `agentcage-egress`
# binary (TLS-intercepting proxy, policy, secret injection, audit) plus
# dnsmasq, for the 2-container per-cage shape (cage + egress).
#
# Both processes run unprivileged inside the container:
#   uid 200 (acproxy) -> agentcage-egress
#   uid 201 (acdns)   -> dnsmasq
# The supervisor at PID 1 (tini -> /opt/agentcage/supervisor) drops CapBnd
# via setpriv on each child, closing the setuid-root reacquisition path
# that --reuid alone leaves open. See supervisor-egress.sh for the full
# security rationale.
#
# No interpreter: the binary is static (linux-musl) and carries its own
# TLS stack and Mozilla roots. ca-certificates stays for anything in the
# image that does TLS through the system store.
#
# update-from: docker.io/library/debian:trixie-slim
FROM docker.io/library/debian@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

#   ca-certificates  — system trust store (the binary embeds its own roots)
#   dnsmasq          — recursive DNS forwarder + allowlist enforcer
#   libcap2-bin      — capsh + setcap (we setcap dnsmasq for :53 bind)
#   iptables         — egress FORWARD-chain shape (egress as router)
#   jq               — utility for parsing JSON config in scripts
#   procps           — pgrep/pkill for the smoke test + general debug
#   tini             — PID 1 -> SIGCHLD reaping + SIGTERM forwarding
#   util-linux       — setpriv (CapBnd drop) + prlimit (memory caps)
#   iproute2         — ss for the supervisor's listener readiness check
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        ca-certificates \
        dnsmasq \
        libcap2-bin \
        iptables \
        jq \
        procps \
        tini \
        util-linux \
        iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Per-component users. uids match the apple-container backend's wrapper
# (which also uses 200/201) so any iptables rule using uid-owner matchers
# in shared scripts works consistently. `acproxy` / `acdns` (not `proxy` /
# `dns`) to avoid colliding with debian's existing `proxy` user at uid 13
# — silently taking that would leave the egress running as uid 13,
# invisible to any uid-200 owner-match.
RUN useradd --uid 200 --system --no-create-home --shell /usr/sbin/nologin --home-dir /var/empty acproxy \
    && useradd --uid 201 --system --no-create-home --shell /usr/sbin/nologin --home-dir /var/empty acdns

# setcap so uid 201 can bind :53. Needs cap_net_bind_service in CapBnd
# at exec time — supervisor-egress.sh handles that (and drops everything
# else) via setpriv --bounding-set=-all,+net_bind_service. NoNewPrivs is
# NOT set on dnsmasq because file caps are blocked under NNP per
# capabilities(7).
RUN setcap cap_net_bind_service=+ep /usr/sbin/dnsmasq

# The egress binary, staged into the build context by the host
# (agentcage-egress-embed carries the linux-musl build matching the
# host's architecture). Its bytes are a content-hash input, so a new
# binary is a new image tag.
COPY bin/agentcage-egress /opt/agentcage/agentcage-egress

# Supervisor + DNS audit wrapper.
COPY containers/supervisor-egress.sh /opt/agentcage/supervisor
COPY containers/dns-audit.sh /opt/agentcage/dns-audit.sh
RUN chmod 0755 /opt/agentcage/agentcage-egress /opt/agentcage/supervisor /opt/agentcage/dns-audit.sh

# Home + log dirs. /home/acproxy/ca is the mount point of the cage's
# private CA store (its own `<name>-certs` volume); the egress generates
# its CA there on first start, and the supervisor publishes only the
# public cert to /home/acproxy/public-certs for the cage. Empty in the
# image: no CA is generated at build time, so a fresh volume starts empty
# and each cage's egress generates its own.
#
# /var/log/agentcage is chmod 1777 (world-writable, sticky bit) so:
#   * the supervisor (PID 1, root) can `touch /var/log/agentcage/ready`
#     in step F without needing CAP_DAC_OVERRIDE — hardened rootless
#     podman setups (`default_capabilities = []` in containers.conf)
#     drop that cap, and the supervisor's strict `set -eu` then exits
#     before either daemon's listener finishes; AND
#   * the egress (uid 200) can still write audit.jsonl / capture.jsonl
#     into the same dir, AND
#   * the sticky bit prevents cross-uid file deletion.
RUN mkdir -p /home/acproxy/ca /var/log/agentcage \
    && chown -R acproxy:acproxy /home/acproxy /var/log/agentcage \
    && chmod 755 /home/acproxy \
    && chmod 1777 /var/log/agentcage
RUN mkdir -p /home/acdns \
    && chown acdns:acdns /home/acdns

# Egress-local DNS apply: the egress publishes the granted zone list here
# and the supervisor renders it into dnsmasq's servers-file. Pre-chowned in
# an image layer for the same reason /home/acdns is — the supervisor must
# not need CAP_CHOWN at runtime (hardened rootless podman drops it). 0700:
# only the egress writes, only root (the supervisor) reads.
RUN mkdir -p /home/acproxy/dns \
    && chown acproxy:acproxy /home/acproxy/dns \
    && chmod 0700 /home/acproxy/dns

ENTRYPOINT ["/usr/bin/tini", "--", "/opt/agentcage/supervisor"]
CMD []
