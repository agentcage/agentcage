#!/bin/bash
# agentcage-nethelper — minimal privileged helper for Firecracker networking
#
# This script is intended to be installed setuid root. It performs ONLY:
#   1. Create/destroy the shared bridge (agentcage-br0)
#   2. Create/destroy TAP devices (tap-{name})
#   3. Set TAP ownership to the calling user
#   4. Add/remove iptables/nftables MASQUERADE and FORWARD rules
#
# Usage:
#   agentcage-nethelper create-bridge
#   agentcage-nethelper destroy-bridge
#   agentcage-nethelper create-tap <cage-name>
#   agentcage-nethelper destroy-tap <cage-name>
#
# Security: strict input validation, no user-controlled paths or shell expansion.

set -euo pipefail

BRIDGE="agentcage-br0"
BRIDGE_IP="10.88.0.1/24"
BRIDGE_SUBNET="10.88.0.0/24"

# Strict cage name validation: lowercase alphanumeric + hyphens, 1-63 chars
validate_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
        echo "error: invalid cage name: '$name'" >&2
        exit 1
    fi
}

# Derive a deterministic IP from the cage name (hash-based, 10.88.0.2-254)
# Must match the Python implementation in network.py (md5, first 8 hex chars)
cage_ip() {
    local name="$1"
    local hash_hex
    hash_hex=$(printf '%s' "$name" | md5sum | cut -c1-8)
    local hash_int
    hash_int=$(printf '%d' "0x${hash_hex}")
    local octet=$(( (hash_int % 253) + 2 ))  # 2-254
    echo "10.88.0.${octet}"
}

cmd_create_bridge() {
    if ip link show "$BRIDGE" &>/dev/null; then
        echo "bridge $BRIDGE already exists"
        return 0
    fi
    ip link add name "$BRIDGE" type bridge
    ip addr add "$BRIDGE_IP" dev "$BRIDGE"
    ip link set "$BRIDGE" up

    # Enable IP forwarding
    sysctl -q -w net.ipv4.ip_forward=1

    # MASQUERADE for VM traffic (idempotent — check before adding)
    if ! iptables -t nat -C POSTROUTING -s "$BRIDGE_SUBNET" ! -o "$BRIDGE" -j MASQUERADE 2>/dev/null; then
        iptables -t nat -A POSTROUTING -s "$BRIDGE_SUBNET" ! -o "$BRIDGE" -j MASQUERADE
    fi

    # FORWARD rules — allow VM-to-internet traffic (outbound via host) but
    # block VM-to-VM traffic on the bridge itself.
    # Allow traffic FROM bridge to non-bridge destinations (VM → internet)
    if ! iptables -C FORWARD -i "$BRIDGE" ! -o "$BRIDGE" -j ACCEPT 2>/dev/null; then
        iptables -I FORWARD -i "$BRIDGE" ! -o "$BRIDGE" -j ACCEPT
    fi
    # Allow established/related return traffic TO bridge
    if ! iptables -C FORWARD -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; then
        iptables -I FORWARD -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    fi
    # Block VM-to-VM traffic (same bridge in and out)
    if ! iptables -C FORWARD -i "$BRIDGE" -o "$BRIDGE" -j DROP 2>/dev/null; then
        iptables -I FORWARD -i "$BRIDGE" -o "$BRIDGE" -j DROP
    fi

    # nftables FORWARD rules — some hosts use nftables (inet filter forward)
    # with policy drop alongside iptables. Both must allow the traffic.
    if command -v nft &>/dev/null && nft list chain inet filter forward &>/dev/null 2>&1; then
        # Drop VM-to-VM traffic first (higher priority)
        nft add rule inet filter forward iifname "$BRIDGE" oifname "$BRIDGE" drop 2>/dev/null || true
        # Allow VM-to-internet (outbound)
        nft add rule inet filter forward iifname "$BRIDGE" oifname != "$BRIDGE" accept 2>/dev/null || true
        # Allow established return traffic
        nft add rule inet filter forward oifname "$BRIDGE" ct state established,related accept 2>/dev/null || true
    fi

    # INPUT rules — only allow VMs to reach the bridge gateway IP itself
    # (for DNS, DHCP, etc.), not arbitrary host services.
    if command -v nft &>/dev/null && nft list chain inet filter input &>/dev/null 2>&1; then
        nft add rule inet filter input iifname "$BRIDGE" ip daddr "${BRIDGE_IP%/*}" accept 2>/dev/null || true
    fi

    if ! iptables -C INPUT -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT 2>/dev/null; then
        iptables -I INPUT -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT
    fi
    # Drop other VM-to-host traffic (to non-bridge IPs)
    if ! iptables -C INPUT -i "$BRIDGE" -j DROP 2>/dev/null; then
        iptables -A INPUT -i "$BRIDGE" -j DROP
    fi
    # If Tailscale's ts-input chain exists, allow only bridge-destined traffic
    if iptables -L ts-input -n &>/dev/null 2>&1; then
        if ! iptables -C ts-input -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT 2>/dev/null; then
            iptables -I ts-input 3 -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT
        fi
    fi

    echo "created bridge $BRIDGE ($BRIDGE_IP)"
}

cmd_destroy_bridge() {
    # Remove nftables FORWARD and INPUT rules
    if command -v nft &>/dev/null; then
        local chain handle
        for chain in forward input; do
            if nft list chain inet filter "$chain" &>/dev/null 2>&1; then
                for handle in $(nft -a list chain inet filter "$chain" 2>/dev/null \
                    | grep -E "iifname \"$BRIDGE\"|oifname \"$BRIDGE\"" \
                    | sed -n 's/.*# handle //p'); do
                    nft delete rule inet filter "$chain" handle "$handle" 2>/dev/null || true
                done
            fi
        done
    fi
    # Remove iptables FORWARD rules
    iptables -D FORWARD -i "$BRIDGE" -o "$BRIDGE" -j DROP 2>/dev/null || true
    iptables -D FORWARD -i "$BRIDGE" ! -o "$BRIDGE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "$BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    # Remove iptables INPUT rules
    iptables -D INPUT -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i "$BRIDGE" -j DROP 2>/dev/null || true
    # Remove Tailscale ts-input rule
    if iptables -L ts-input -n &>/dev/null 2>&1; then
        iptables -D ts-input -i "$BRIDGE" -d "${BRIDGE_IP%/*}" -j ACCEPT 2>/dev/null || true
    fi
    # Remove MASQUERADE rule
    iptables -t nat -D POSTROUTING -s "$BRIDGE_SUBNET" ! -o "$BRIDGE" -j MASQUERADE 2>/dev/null || true
    ip link delete "$BRIDGE" 2>/dev/null || true
    echo "destroyed bridge $BRIDGE"
}

cmd_create_tap() {
    local name="$1"
    validate_name "$name"

    local tap="tap-${name}"
    local caller_uid="${SUDO_UID:-${PKEXEC_UID:-$(id -ru)}}"

    # Ensure bridge exists
    if ! ip link show "$BRIDGE" &>/dev/null; then
        cmd_create_bridge
    fi

    # Create TAP device
    if ip link show "$tap" &>/dev/null; then
        echo "TAP $tap already exists"
    else
        ip tuntap add dev "$tap" mode tap user "$caller_uid"
        ip link set "$tap" master "$BRIDGE"
        ip link set "$tap" up
        echo "created TAP $tap (owner uid=$caller_uid)"
    fi
}

cmd_destroy_tap() {
    local name="$1"
    validate_name "$name"

    local tap="tap-${name}"
    if ip link show "$tap" &>/dev/null; then
        ip link delete "$tap"
        echo "destroyed TAP $tap"
    else
        echo "TAP $tap does not exist"
    fi
}

# Main dispatch
case "${1:-}" in
    create-bridge)
        cmd_create_bridge
        ;;
    destroy-bridge)
        cmd_destroy_bridge
        ;;
    create-tap)
        [[ $# -ge 2 ]] || { echo "usage: $0 create-tap <cage-name>" >&2; exit 1; }
        cmd_create_tap "$2"
        ;;
    destroy-tap)
        [[ $# -ge 2 ]] || { echo "usage: $0 destroy-tap <cage-name>" >&2; exit 1; }
        cmd_destroy_tap "$2"
        ;;
    *)
        echo "usage: $0 {create-bridge|destroy-bridge|create-tap|destroy-tap} [cage-name]" >&2
        exit 1
        ;;
esac
