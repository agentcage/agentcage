# Containerfile.vmbase — builds the base VM rootfs for Firecracker
#
# Contains: Fedora Minimal, Podman, and basic tools.
# This image is exported to an ext4 rootfs, not run as a container.
#
# Must be built with --cap-add=all (Fedora RPMs set file capabilities).

FROM registry.fedoraproject.org/fedora-minimal:43

# Podman + dependencies (--setopt=install_weak_deps=0 keeps it lean)
RUN microdnf install -y --setopt=install_weak_deps=0 \
    podman \
    fuse-overlayfs \
    iptables \
    iproute \
    socat \
    python3 \
    python3-pyyaml \
    bash \
    coreutils \
    gzip \
    procps-ng \
    && microdnf clean all

RUN podman --version

# Create agentcage user
RUN useradd -u 1000 -m agentcage \
    && echo "agentcage:100000:65536" >> /etc/subuid \
    && echo "agentcage:100000:65536" >> /etc/subgid

# Configure root Podman storage (native overlay — kernel 6.1+ supports it)
RUN mkdir -p /run/containers/storage \
    && printf '[storage]\ndriver = "overlay"\nrunroot = "/run/containers/storage"\ngraphroot = "/var/lib/containers/storage"\n' \
       > /etc/containers/storage.conf

# Disable nftables firewall driver — Firecracker microvm kernels typically
# lack CONFIG_NF_TABLES.  NAT rules are set up manually via iptables-legacy
# in start-cage.sh instead.
RUN printf '[network]\nfirewall_driver = "none"\n' \
       > /etc/containers/containers.conf

# Pre-create directories for agentcage injected files
RUN mkdir -p /var/lib/agentcage/quadlets /var/lib/agentcage/images /etc/agentcage

# Copy VM init script
COPY firecracker/vm-init.sh /usr/local/bin/vm-init.sh
RUN chmod +x /usr/local/bin/vm-init.sh
