# agentcage configuration for {{ name }} (Claude Code scaffold)
#
# Quick start:
#   1. Deploy:  agentcage cage create -c cage.yaml
#   2. Start a session:
#        agentcage cage exec {{ name }} -- claude
#   3. Or use the run command:
#        agentcage run claude-code
#
# Authentication — pick one:
#   A — Subscription, log in inside the cage:
#     agentcage cage exec {{ name }} -- claude login
#     (follow the URL; the token is saved under /home/node/.claude in the
#     cage's writable layer. To persist it across image rebuilds, uncomment
#     the ~/.claude host mount in `volumes` below — see security note there.)
#
#   B — Subscription, reuse your host login (no in-cage login):
#     claude setup-token                  # on the host — mints a long-lived token
#     agentcage secret set {{ name }} CLAUDE_CODE_OAUTH_TOKEN
#     (also uncomment the CLAUDE_CODE_OAUTH_TOKEN block under secret_injection)
#
#   C — API key:
#     agentcage secret set {{ name }} ANTHROPIC_API_KEY
#     agentcage cage restart {{ name }}

name: {{ name }}
{% if isolation == "vm" %}

isolation: vm

vm:
  vcpus: 4
  mem_mb: 8192
{% endif %}

lifecycle: interactive

scaffold: claude-code

container:
  image: "localhost/agentcage-scaffold-claude-code:latest"
  build:
    containerfile: "Containerfile"
  command: ["sleep", "infinity"]

  # Project directory — mount your repo here
  volumes:
    - "${PROJECT_DIR}:/workspace:rw"
    # Auth & settings — uncomment to mount host ~/.claude so login persists
    # across sessions. Disabled by default: the host ~/.claude tree contains
    # credentials, OAuth tokens, transcripts, MCP configs, and project
    # memory that the cage shouldn't see or be able to mutate. Prefer
    # in-cage `claude login` (volume-backed) or CLAUDE_CODE_OAUTH_TOKEN.
    #- "~/.claude:/home/node/.claude:rw"
    # ~/.claude.json (Claude Code's global UX config) is intentionally NOT
    # mounted by default. Uncomment if you want your host preferences (model
    # choice, theme, etc.) to follow you into the cage. Only enable this
    # together with the ~/.claude mount above — without ~/.claude, the
    # paths referenced in ~/.claude.json (projects, MCP servers, history)
    # won't exist inside the cage.
    # Note: the VM backend stages a one-way copy (cage edits don't flow back).
    #- "~/.claude.json:/home/node/.claude.json:rw"
  #  # Git config (uncomment to enable)
  #  - "~/.gitconfig:/home/node/.gitconfig:ro"
  #  - "~/.ssh/known_hosts:/home/node/.ssh/known_hosts:ro"

  # Map host UID into container so mounted files have correct ownership
  userns: "keep-id"
  user: ""

  # Coding agents need to write to various paths in the home directory
  read_only: false

  tmpfs:
    - "/tmp:rw,noexec,nosuid,size=256M"
    # Mask the host's .git/hooks/ so a caged agent can't plant a git hook
    # (pre-commit, post-checkout, …) that the next host-side `git commit`
    # runs as the host user — a cage→host pivot (#170). tmpfs overlays the
    # bind-mounted path: the cage sees an empty, transient .git/hooks/
    # (writes vanish on stop); the host's hooks are untouched.
    # `notmpcopyup` is what makes "empty" true (#328). Without it podman
    # copies the host's hooks into the mask, and the mask is `noexec` so
    # none of them could ever run in the cage anyway — the copy would only
    # add confusion plus a Permission denied whenever the agent edits one.
    - "/workspace/.git/hooks/:rw,noexec,nosuid,nodev,size=64M,notmpcopyup"
    # Mask the project-local .claude/ so a caged agent can't plant a
    # malicious .claude/settings.json `hooks` block that Claude Code in
    # another cage honors on launch — a cage→cage hooks-injection chain
    # (#173). This is the PROJECT-level .claude/ under /workspace (read
    # from the RW bind-mount), not the cage's own ~/.claude home (which
    # holds CLAUDE.md, login creds, and in-cage settings).
    # `tmpcopyup` seeds the mask with a COPY of the project's .claude/, so
    # the caged agent still reads the project's settings, commands and
    # subagents (#328) — they do not have to be baked into the cage image.
    # The copy is the cage's own throwaway: agentcage hands it to the cage
    # user so the agent can edit it, and every write dies with the cage.
    # Nothing the cage writes here reaches the host, so the #173 cage→cage
    # chain stays closed.
    - "/workspace/.claude/:rw,noexec,nosuid,nodev,size=64M,tmpcopyup"

  # Resource limits
  memory: "8g"
  cpus: "4.0"

  timeout_start_sec: 60

# ── Secret injection ──
# API keys are swapped by the proxy — the cage only sees placeholders.
# Placeholders are generated decoy tokens, unique per cage — entropy keeps
# real outbound content from ever colliding with one.
# Create each secret:  agentcage secret set {{ name }} ANTHROPIC_API_KEY
secret_injection:
  - env: ANTHROPIC_API_KEY
    placeholder: "{{ placeholder('ANTHROPIC_API_KEY') }}"
    inject_to:
      - anthropic.com

  # Subscription auth without an in-cage `claude login`. Mint a long-lived
  # token on the host with `claude setup-token`, then:
  #   agentcage secret set {{ name }} CLAUDE_CODE_OAUTH_TOKEN
  # Claude Code reads CLAUDE_CODE_OAUTH_TOKEN and sends it as a bearer token;
  # the proxy swaps the placeholder for the real value en route to anthropic.com.
  # If you enable this, remove the ANTHROPIC_API_KEY rule above — Claude Code
  # prefers the API key when both are set.
  #- env: CLAUDE_CODE_OAUTH_TOKEN
  #  placeholder: "{{ placeholder('CLAUDE_CODE_OAUTH_TOKEN') }}"
  #  inject_to:
  #    - anthropic.com

  # Uncomment for GitHub push via HTTPS:
  #- env: GITHUB_TOKEN
  #  placeholder: "{{ placeholder('GITHUB_TOKEN') }}"
  #  inject_to:
  #    - github.com

# ── Domain allowlist ──
# Subdomains are matched automatically (e.g. "anthropic.com" also allows
# "api.anthropic.com").
domains:
  allow:
    # ── AI provider ──
    - anthropic.com
    - claude.com

    # ── Telemetry (commented out by default) ──
    # Claude Code may hang on startup if these are blocked AND it's
    # configured to report telemetry. If `claude` hangs at the splash
    # screen, uncomment these (or disable telemetry in `~/.claude/settings.json`
    # with `"telemetry": "disabled"` — preferred for sandbox use).
    #- datadoghq.com
    #- githubusercontent.com
    #- sentry.io

    # ── Package registries (commented out by default) ──
    # Claude Code's deps are installed at image-build time (see Containerfile),
    # so the running cage doesn't need access to public package indexes.
    # Uncomment the ones you need if your agent installs packages at
    # runtime (e.g. `npm install` in /workspace, `pip install`, etc.).
    #- npmjs.org
    #- npmjs.com
    #- pypi.org
    #- files.pythonhosted.org
    #- nodejs.org

    # ── Code hosting (uncomment for git push) ──
    #- github.com
    #- githubusercontent.com

    # Add domains your agent needs access to:
    #- example.com

# ── Logging ──
logging:
  level: info
  dns: warning

# ── Inspectors ──
inspectors:
  - name: content-type
  # Add `- name: entropy` to also flag encrypted/compressed payloads
  # (off by default — it false-positives on legitimate high-entropy data).

# ── Exec aliases ──
exec_aliases:
  claude: ["claude"]

# ── Help ──
help: |
  Start a Claude Code session:
    agentcage cage exec {{ name }} -- claude

  Or use the run command (creates ephemeral cage):
    agentcage run claude-code

  Authentication:
    Subscription: agentcage cage exec {{ name }} -- claude login
    API key:      agentcage secret set {{ name }} ANTHROPIC_API_KEY
