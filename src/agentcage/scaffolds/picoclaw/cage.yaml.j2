# agentcage configuration for {{ name }} (PicoClaw scaffold)
{% set gateway_port = port | default(18790, true) %}

name: {{ name }}
{% if isolation == "firecracker" %}

isolation: firecracker

firecracker:
  vcpus: 1
  mem_mb: 512
  # kernel: ""            # auto-detected; set to override
  # firecracker_bin: ""   # auto-detected; set to override
{% endif %}

container:
  # Built from main — v0.1.2 lacks HTTP proxy support for web tools.
  # See "Build from source" above.
  image: "localhost/picoclaw:latest"
  command: ["gateway"]

  env:
    # Explicit proxy URL for PicoClaw's web tools (web_fetch, web_search).
    # Required for v0.1.2; can be removed once a release with built-in
    # HTTP_PROXY support ships.
    PICOCLAW_TOOLS_WEB_PROXY: "http://{{ ip_proxy }}:8080"

  # Mount your config file (create it before deploying)
  volumes:
    - "~/.picoclaw/config.json:/home/picoclaw/.picoclaw/config.json:ro"

  # Podman named volume for persistent workspace (sessions, memory, templates)
  named_volumes:
    picoclaw-workspace: "/home/picoclaw/.picoclaw/workspace:rw"

  # Writable directories on the read-only root filesystem
  tmpfs:
    - "/tmp:rw,noexec,nosuid,size=64M"

  # Gateway web UI — bind to localhost only (BIND:HOST_PORT:CONTAINER_PORT)
  ports:
    - "127.0.0.1:{{ gateway_port }}:18790"
    # Webhook ports (uncomment as needed):
    #- "127.0.0.1:18791:18791"   # LINE
    #- "127.0.0.1:18792:18792"   # WeCom App
    #- "127.0.0.1:18793:18793"   # WeCom Bot

  # Resource limits — PicoClaw is ultra-lightweight (~10 MB image, ~10-20 MB RAM)
  memory: "256m"
  cpus: "0.5"

  # Fast Go binary — starts in ~1 second
  timeout_start_sec: 30

# ── Secret injection ──
# API keys are swapped by the proxy — the cage only sees placeholders.
# Put placeholders (e.g. {{ANTHROPIC_API_KEY}}) in ~/.picoclaw/config.json
# and create each secret:  agentcage secret set {{ name }} ANTHROPIC_API_KEY
secret_injection:
  # Core AI provider
  - env: ANTHROPIC_API_KEY
    placeholder: "{%raw%}{{ANTHROPIC_API_KEY}}{%endraw%}"
    inject_to:
      - anthropic.com

  # Uncomment providers as needed:
  #- env: OPENAI_API_KEY
  #  placeholder: "{%raw%}{{OPENAI_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - openai.com
  #- env: OPENROUTER_API_KEY
  #  placeholder: "{%raw%}{{OPENROUTER_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - openrouter.ai

# ── Domain allowlist ──
# Subdomains are matched automatically (e.g. "openai.com" also allows
# "api.openai.com"). Sibling domains are NOT matched.
domains:
  allow:
    # ── AI providers (uncomment those you configure in config.json) ──
    - anthropic.com
    - openai.com
    #- openrouter.ai
    #- generativelanguage.googleapis.com   # Gemini
    #- api.deepseek.com
    #- api.groq.com
    #- open.bigmodel.cn                    # Zhipu

    # ── Web search ──
    #- search.brave.com
    #- duckduckgo.com
    #- api.perplexity.ai

    # ── Skills registry ──
    #- clawhub.ai

    # ── Messaging channels (uncomment those you use) ──
    #- api.telegram.org
    #- discord.com
    #- gateway.discord.gg

    # Add domains your agent needs access to:
    #- example.com

# ── Traffic capture (HAR export) ──
# Record decrypted request/response bodies for forensic analysis.
# Export with: agentcage cage har {{ name }}
#capture:
#  enable_har: true
#  min_action: all             # "all", "flag", or "block"
#  max_body_size: 10485760     # 10MB per body

# ── Logging ──
logging:
  level: info
  dns: warning

# ── Inspectors ──
inspectors:
  - name: entropy
  - name: content-type
