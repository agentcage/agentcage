FROM docker.io/library/debian:stable-slim

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        curl \
        openssh-client \
        build-essential \
        python3 \
        ripgrep \
        fd-find \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

# The unprivileged cage user: `agent`, uid/gid 1000, home /home/agent. The
# uid matches the `node` user the image used to inherit from node:22-slim,
# so host file ownership is unchanged. Debian's useradd creates homes 0700;
# make it 0755.
RUN groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid agent --shell /bin/bash --create-home agent \
    && chmod 0755 /home/agent

# Install the Pi coding agent (latest release) from upstream's standalone
# Linux build: one self-contained executable (Bun runtime bundled) plus its
# theme/asset files. Debian stable's nodejs (20.19) is older than Pi's
# `engines` floor (node >=22.19.0), and the npm route pulls unpinned
# transitive deps from the registry; the release tarball is one artifact from
# github.com, checked against the release's SHA256SUMS. Pass
# --build-arg PI_VERSION=1.2.0 to build a specific release instead.
ARG PI_VERSION=latest
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
        amd64) pi_arch=x64 ;; \
        arm64) pi_arch=arm64 ;; \
        *) echo "pi: no standalone build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    if [ "$PI_VERSION" = latest ]; then \
        base=https://github.com/earendil-works/pi/releases/latest/download; \
    else \
        base="https://github.com/earendil-works/pi/releases/download/v${PI_VERSION}"; \
    fi; \
    tarball="pi-linux-${pi_arch}.tar.gz"; \
    mkdir -p /tmp/pi-dl /opt/pi; \
    curl -fsSL -o "/tmp/pi-dl/$tarball" "$base/$tarball"; \
    curl -fsSL -o /tmp/pi-dl/SHA256SUMS "$base/SHA256SUMS"; \
    (cd /tmp/pi-dl && grep " ${tarball}\$" SHA256SUMS | sha256sum -c -); \
    tar -xzf "/tmp/pi-dl/$tarball" -C /opt/pi --strip-components=1 --no-same-owner; \
    rm -f "/tmp/pi-dl/$tarball" /tmp/pi-dl/SHA256SUMS; \
    rmdir /tmp/pi-dl; \
    ln -s /opt/pi/pi /usr/local/bin/pi

# agentcage introspection: bake a short "you are sandboxed" brief into Pi's
# global context file (~/.pi/agent/AGENTS.md) so the agent discovers it is
# caged with zero setup. agentcage stages the canonical AGENTS.md brief into
# the build context (see agentcage.scaffold_brief) — not committed per-scaffold.
#
# Delivered as a plain, writable, agent-owned file — deliberately NOT a
# read-only bind mount over ~/.pi (that makes the runtime create ~/.pi
# root-owned, breaking Pi's own state/session writes). Pi keeps full
# ownership of ~/.pi.
RUN mkdir -p /home/agent/.pi/agent
COPY AGENTS.md /home/agent/.pi/agent/AGENTS.md
RUN chown -R agent:agent /home/agent/.pi

# agentcage skill: the Policy API how-to (reflect on the allowlist, request a
# domain, give a grant back) as an Agent Skills package. Pi discovers skills in
# ~/.agents/skills (cross-agent, and not shadowed if an operator bind-mounts
# ~/.pi over the image). Staged into the build context by agentcage like the
# brief above (scaffolds/skills/agentcage) — not committed per-scaffold.
COPY skills/agentcage /home/agent/.agents/skills/agentcage
RUN chown -R agent:agent /home/agent/.agents

USER agent
WORKDIR /workspace
