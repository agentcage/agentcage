ARG BASE_IMAGE=ghcr.io/openclaw/openclaw:latest
FROM $BASE_IMAGE

USER root

RUN printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/99rootless \
  && apt-get update && apt-get install -y --no-install-recommends \
        # ── Nested-container runtime ──
        podman fuse-overlayfs crun uidmap slirp4netns ca-certificates \
        # ── Chromium / Playwright runtime deps ──
        libnss3 libnss3-tools libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
        libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 \
        libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
        libcairo2 libasound2 fonts-liberation xdg-utils \
        # ── Voice / media / data tools ──
        curl ffmpeg imagemagick \
        python3 python3-pip python3-numpy python3-pandas \
        python3-pil python3-requests \
        sqlite3 libespeak-ng1 espeak-ng-data \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --no-cache-dir --system --break-system-packages \
    faster-whisper piper-tts

RUN cd /app/extensions/matrix \
  && node -e "const p=require('./package.json'); delete p.devDependencies; require('fs').writeFileSync('package.json', JSON.stringify(p,null,2))" \
  && npm install --omit=dev

RUN echo "node:100000:65536" >> /etc/subuid \
 && echo "node:100000:65536" >> /etc/subgid

RUN mkdir -p /home/node/.config/containers \
 && printf '[storage]\ndriver = "overlay"\ngraphroot = "/var/lib/containers/storage"\nrunroot = "/run/containers/storage"\n\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' \
    > /home/node/.config/containers/storage.conf \
 && chown -R node:node /home/node/.config

USER node
