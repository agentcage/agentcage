# agentcage configuration for {{ name }} (OpenClaw scaffold)
{% set gateway_port = port | default(18789, true) %}
#
# Quick start:
#   1. Set secrets:
#        agentcage secret set {{ name }} ANTHROPIC_API_KEY
#        agentcage secret set {{ name }} OPENCLAW_GATEWAY_PASSWORD
#   2. Uncomment additional providers / domains you need
#   3. Deploy:  agentcage cage create -c cage.yaml

name: {{ name }}
{% if isolation == "vm" %}

isolation: vm

vm:
  vcpus: 4
  mem_mb: 8192
{% endif %}

container:
  image: "localhost/agentcage-scaffold-openclaw:latest"
  build:
    containerfile: "Containerfile"
    args:
      BASE_IMAGE: "ghcr.io/openclaw/openclaw"
  nested_containers: true
  command:
    - "sh"
    - "-c"
    - "cp /certs/mitmproxy-ca-cert.pem /usr/local/share/ca-certificates/mitmproxy.crt && update-ca-certificates 2>/dev/null; mkdir -p /home/node/.pki/nssdb && certutil -d sql:/home/node/.pki/nssdb -N --empty-password 2>/dev/null; certutil -d sql:/home/node/.pki/nssdb -A -t 'C,,' -n mitmproxy -i /certs/mitmproxy-ca-cert.pem 2>/dev/null; chmod 700 /home/node/.openclaw; test -f /home/node/.openclaw/openclaw.json || printf '{\"browser\": {\"defaultProfile\": \"openclaw\"}, \"gateway\": {\"trustedProxies\": [\"{{ ip_proxy }}\"], \"controlUi\": {\"allowedOrigins\": [\"http://localhost:{{ gateway_port }}\", \"http://127.0.0.1:{{ gateway_port }}\"]} } }' > /home/node/.openclaw/openclaw.json; chmod 600 /home/node/.openclaw/openclaw.json; exec node openclaw.mjs gateway --allow-unconfigured --bind lan --auth password"

  add_capabilities:
    - NET_BIND_SERVICE

  # Podman named volumes for persistent state
  named_volumes:
    {{ name }}-workspace: "/workspace:rw"
    {{ name }}-state: "/home/node/.openclaw:rw"

  # Writable directories on the read-only root filesystem
  tmpfs:
    - "/tmp:rw,noexec,nosuid,size=4G"
    - "/home/node/.npm:rw,size=512M"
    - "/home/node/.pki:rw,size=16M"
    - "/scratch:rw,exec,nosuid,size=8G"

  # Gateway web UI — published on the host (BIND:HOST_PORT:CONTAINER_PORT)
  # To allow access from other machines on the LAN:
  #   1. Change 127.0.0.1 to 0.0.0.0 below
  #   2. Delete the state volume so openclaw.json is regenerated:
  #        podman volume rm {{ name }}-state
  #   3. Replace the "controlUi" block in the command above with:
  #        \"controlUi\": {\"dangerouslyAllowHostHeaderOriginFallback\": true}
  #   4. Recreate the cage:  agentcage cage create -c cage.yaml
  ports:
    - "127.0.0.1:{{ gateway_port }}:18789"

  # Disable mDNS/Bonjour broadcasts (not useful inside a container)
  env:
    OPENCLAW_DISABLE_BONJOUR: "1"
    HOME: "/home/node"

  # Cage-internal secrets (not API keys — use secret_injection for those).
  # Create first:  agentcage secret set {{ name }} OPENCLAW_GATEWAY_PASSWORD
  podman_secrets:
    - OPENCLAW_GATEWAY_PASSWORD

  # Resource limits
  memory: "8g"
  cpus: "4.0"

  # OpenClaw startup is slow — give it time
  timeout_start_sec: 120

# ── Upstream DNS ──
# Default: 1.1.1.1, 8.8.8.8 (Cloudflare + Google)
# Uncomment for Tailscale MagicDNS (resolves *.ts.net hostnames):
# dns_servers:
#   - 100.100.100.100
#   - 1.1.1.1
#   - 8.8.8.8

# ── Secret injection ──
# API keys are swapped by the proxy — the cage only sees placeholders.
# Create each secret:  agentcage secret set {{ name }} ANTHROPIC_API_KEY
secret_injection:
  # Core AI provider
  - env: ANTHROPIC_API_KEY
    placeholder: "{%raw%}{{ANTHROPIC_API_KEY}}{%endraw%}"
    inject_to:
      - anthropic.com

  # Uncomment providers as needed:
  #- env: OPENAI_API_KEY
  #  placeholder: "{%raw%}{{OPENAI_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - openai.com
  #- env: OPENROUTER_API_KEY
  #  placeholder: "{%raw%}{{OPENROUTER_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - openrouter.ai

  # Web search
  #- env: BRAVE_API_KEY
  #  placeholder: "{%raw%}{{BRAVE_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - search.brave.com

  # Web scraping
  #- env: FIRECRAWL_API_KEY
  #  placeholder: "{%raw%}{{FIRECRAWL_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - firecrawl.dev

# ── Domain allowlist ──
# Subdomains are matched automatically (e.g. "github.com" also allows
# "api.github.com"). Sibling domains are NOT matched — "github.com" does
# not allow "githubusercontent.com", so add it separately.
domains:
  allow:
    # ── Core AI providers ──
    - anthropic.com
    #- openai.com
    #- openrouter.ai

    # ── Package registries ──
    - npmjs.org
    - npmjs.com
    - pypi.org
    - files.pythonhosted.org
    - nodejs.org

    # ── CDNs ──
    - cdn.jsdelivr.net
    - unpkg.com
    - esm.sh

    # ── Code hosting ──
    - github.com
    - githubusercontent.com
    #- gitlab.com

    # ── Container registries (needed for nested containers) ──
    - docker.io
    - registry-1.docker.io
    - auth.docker.io
    - production.cloudflare.docker.com
    - ghcr.io
    - pkg-containers.githubusercontent.com
    - r2.cloudflarestorage.com

    # ── Browser automation (Playwright / Chrome) ──
    - cdn.playwright.dev
    - playwright.download.prss.microsoft.com
    - storage.googleapis.com

    # ── OS packages ──
    - debian.org
    - dl-cdn.alpinelinux.org

    # ── Web search ──
    #- search.brave.com        # requires BRAVE_API_KEY secret
    #- perplexity.ai
    #- firecrawl.dev           # requires FIRECRAWL_API_KEY secret

    # ── AI/ML services ──
    #- huggingface.co
    #- hf.co
    #- pytorch.org

    # ── Messaging ──
    #- api.telegram.org
    #- discord.com
    #- slack.com

    # Add domains your agents need access to:
    #- example.com

# ── Traffic capture (HAR export) ──
# Record decrypted request/response bodies for forensic analysis.
# Export with: agentcage cage har {{ name }}
# See: docs/configuration.md#traffic-capture
#capture:
#  enable_har: true
#  min_action: all             # "all", "flag", or "block"
#  max_body_size: 10485760     # 10MB per body

# ── Logging ──
logging:
  level: info
  dns: warning

# ── Inspectors ──
inspectors:
  - name: entropy
  - name: content-type
  # Allow Docker registry JWT auth tokens to reach container registries
  - name: secrets
    config:
      allow_to_domains:
        azure_jwt:
          - docker.io
          - registry-1.docker.io
          - auth.docker.io

# ── Exec aliases ──
# Shorthand for 'agentcage cage exec' commands
exec_aliases:
  openclaw: ["node", "openclaw.mjs"]

# ── Help ──
# Shown after 'cage create' and 'cage update'
help: |
  Open http://localhost:{{ gateway_port }} in your browser.

  On first connection, approve the device pairing:
    agentcage cage exec {{ name }} -- openclaw devices list
    agentcage cage exec {{ name }} -- openclaw devices approve <request-id>

  Common commands:
    agentcage cage exec {{ name }} -- openclaw health
    agentcage cage exec {{ name }} -- openclaw status
    agentcage cage logs {{ name }}
    agentcage cage logs {{ name }} -s proxy
