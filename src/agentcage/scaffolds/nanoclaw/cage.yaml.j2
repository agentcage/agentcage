# agentcage configuration for {{ name }} (NanoClaw scaffold)
#
# Requires three images (build in order):
#   ./build.sh                    (or: agentcage build nested-base first)
#   ./build-agent.sh
#   ./preload-agent.sh {{ name }}
#
# Quick start:
#   1. Build images (see above)
#   2. Set secrets:
#        agentcage secret set {{ name }} ANTHROPIC_API_KEY
#   3. Deploy:  agentcage cage create -c cage.yaml
#
# The cage runs NanoClaw with the nanoclaw-agent image preloaded.
# Inner agent containers use --network host to reach the API
# through the cage's proxy. The .env placeholder is swapped by
# the proxy so no real secret enters the cage.

name: {{ name }}

container:
  image: "localhost/agentcage-scaffold-nanoclaw"
  nested_containers: true
  command: ["node", "dist/index.js"]

  # Persistent state (named volumes survive cage rebuilds)
  named_volumes:
    nanoclaw-{{ name }}-store: "/app/store:rw"
    nanoclaw-{{ name }}-groups: "/app/groups:rw"
    nanoclaw-{{ name }}-data: "/app/data:rw"

  # Writable directories on the read-only root filesystem
  tmpfs:
    - "/tmp:rw,noexec,nosuid,size=512M"
    - "/scratch:rw,exec,nosuid,size=2G"

  # Resource limits
  memory: "4g"
  cpus: "2.0"

  # NanoClaw spawns containers — give it time to start
  timeout_start_sec: 120

# ── Secret injection ──
# API keys are swapped by the proxy — the cage only sees placeholders.
# The .env inside the image contains {{ANTHROPIC_API_KEY}} which NanoClaw
# reads and passes to agent containers. The proxy replaces placeholders
# with real keys on the wire.
# Create each secret:  agentcage secret set {{ name }} ANTHROPIC_API_KEY
secret_injection:
  - env: ANTHROPIC_API_KEY
    placeholder: "{%raw%}{{ANTHROPIC_API_KEY}}{%endraw%}"
    inject_to:
      - anthropic.com

  # Uncomment providers as needed:
  #- env: OPENAI_API_KEY
  #  placeholder: "{%raw%}{{OPENAI_API_KEY}}{%endraw%}"
  #  inject_to:
  #    - openai.com

# ── Domain allowlist ──
# Inner agent containers use --network host (patched), so all traffic
# flows through the cage's proxy and is subject to domain filtering.
domains:
  allow:
    # ── Core AI providers ──
    - anthropic.com
    #- openai.com
    #- openrouter.ai

    # ── Container registries (for pulling inner images) ──
    - docker.io
    - registry-1.docker.io
    - auth.docker.io
    - production.cloudflare.docker.com
    - r2.cloudflarestorage.com

    # ── Package registries ──
    - npmjs.org
    - npmjs.com
    - pypi.org
    - files.pythonhosted.org
    - nodejs.org

    # ── Code hosting ──
    - github.com
    - githubusercontent.com

    # Add domains your agents need access to:
    #- example.com

# ── Traffic capture (HAR export) ──
# Record decrypted request/response bodies for forensic analysis.
# Export with: agentcage cage har {{ name }}
#capture:
#  enable_har: true
#  min_action: all             # "all", "flag", or "block"
#  max_body_size: 10485760     # 10MB per body

# ── Logging ──
logging:
  level: info
  dns: warning

# ── Inspectors ──
inspectors:
  - name: entropy
  - name: content-type
  # Allow Docker registry JWT auth tokens to reach container registries
  - name: secrets
    config:
      allow_to_domains:
        azure_jwt:
          - docker.io
          - registry-1.docker.io
          - auth.docker.io
