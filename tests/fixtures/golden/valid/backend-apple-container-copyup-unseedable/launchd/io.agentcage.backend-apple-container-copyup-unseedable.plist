<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.agentcage.backend-apple-container-copyup-unseedable</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/container</string>
        <string>start</string>
        <string>backend-apple-container-copyup-unseedable</string>
    </array>
    <key>StandardOutPath</key>
    <string>{{XDG_CONFIG_HOME}}/agentcage/apple-container/backend-apple-container-copyup-unseedable/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{XDG_CONFIG_HOME}}/agentcage/apple-container/backend-apple-container-copyup-unseedable/launchd.err.log</string>
</dict>
</plist>
