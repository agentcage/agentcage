[Unit]
Description=agentcage cage
Requires=container-nested-egress.service
After=container-nested-egress.service

[Container]
ContainerName=container-nested-cage
Image=docker.io/library/node:22-slim
Network=container-nested-net.network:ip=10.89.210.2
Environment="HTTP_PROXY=http://10.89.210.10:8080"
Environment="HTTPS_PROXY=http://10.89.210.10:8080"
Environment="http_proxy=http://10.89.210.10:8080"
Environment="https_proxy=http://10.89.210.10:8080"
Environment="NODE_EXTRA_CA_CERTS=/certs/mitmproxy-ca-cert.pem"
Environment="SSL_CERT_FILE=/certs/mitmproxy-ca-cert.pem"
Environment="AGENTCAGE_VERSION=0.0.0-golden"
Volume=container-nested-public-certs.volume:/certs:ro,Z
Volume={{WORK}}/patches/resolv-container-nested.conf:/etc/resolv.conf:ro,Z
User=0
ReadOnly=true
SecurityLabelDisable=true
AddCapability=SYS_ADMIN
AddCapability=SYS_CHROOT
AddCapability=MKNOD
AddCapability=SETUID
AddCapability=SETGID
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=FSETID
AddCapability=KILL
AddCapability=NET_ADMIN
AddCapability=NET_BIND_SERVICE
AddCapability=NET_RAW
AddCapability=SETFCAP
AddCapability=SETPCAP
AddCapability=AUDIT_WRITE
AddDevice=/dev/fuse
Environment="CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf"
PodmanArgs=--security-opt seccomp=unconfined
PodmanArgs=--security-opt unmask=ALL
Volume=container-nested-podman-storage.volume:/var/lib/containers:rw
Volume={{WORK}}/patches/nested/docker:/usr/local/bin/docker:ro,Z
Volume={{WORK}}/patches/nested/storage.conf:/etc/containers/storage.conf:ro,Z
Volume={{WORK}}/patches/nested/containers.conf:/etc/containers/containers.conf:ro,Z
Volume={{WORK}}/patches/nested/registries.conf:/etc/containers/registries.conf:ro,Z
Tmpfs=/run:rw,exec,size=256M,mode=1777
Exec=node /app/agent.js

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do podman exec container-nested-egress test -f /home/acproxy/.mitmproxy/mitmproxy-ca-cert.pem && exit 0; sleep 1; done; echo "Timed out waiting for CA cert"; exit 1'
# Add the cage's default route via the egress container. Retries because
# the container PID is briefly invalid (0/empty) right after `podman start`
# returns and before the container's init has fully populated state.
# Without the retry, the route is silently skipped on a restart, the
# cage has no outbound network, and every fetch from inside the cage
# fails fast with ECONNREFUSED — surfacing as 502s in tests that
# exercise the data path after a domain add or secret set restart.
ExecStartPost=/bin/sh -c 'LAST_ERR=""; for i in $(seq 1 30); do PID=$(podman inspect --format "{{.State.Pid}}" container-nested-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then LAST_ERR=$(nsenter -t "$PID" -U -n -- ip route replace default via 10.89.210.10 2>&1) && { echo "added default route via 10.89.210.10 (attempt $i)"; exit 0; }; fi; sleep 0.5; done; echo "WARNING: failed to add cage default route via 10.89.210.10 after 30 attempts: $LAST_ERR" >&2; exit 1'
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
