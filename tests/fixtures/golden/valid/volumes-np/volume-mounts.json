{
  "mask_copyup_entries": [],
  "mask_mountpoint_dirs": [],
  "mount_targets": [
    [
      "/workspace",
      ""
    ]
  ],
  "tmpfs": [],
  "volumes": [
    {
      "non_persistent": true,
      "options": [
        "np"
      ],
      "raw_options": "np",
      "source": "${HOME}/workspace",
      "spec": "${HOME}/workspace:/workspace:np",
      "target": "/workspace"
    }
  ]
}
