{
  "agents": {
    "decider": {
      "api_key": "systemd-creds:FAKE_DECIDER_KEY",
      "base_url": "https://openrouter.example.com/api/v1",
      "context": "",
      "enable": true,
      "host": "agentcage.local",
      "max_tokens": 8192,
      "model": "vendor/model-fake",
      "provider": "openrouter",
      "rate_limit_burst": 5,
      "rate_limit_rps": 1.0,
      "timeout_seconds": 15.0
    },
    "watcher": {
      "api_key": "",
      "auto_revoke": true,
      "base_url": "",
      "context": "",
      "dedup_samples": true,
      "enable": false,
      "interval_seconds": 900.0,
      "max_digest_tokens": 8000,
      "max_flows": 200,
      "max_tokens": 8192,
      "model": "",
      "provider": "",
      "timeout_seconds": 30.0,
      "window_seconds": 3600.0
    }
  },
  "apple_container_autostart": false,
  "capture": {
    "domains": [],
    "enable_har": false,
    "exclude_domains": [],
    "max_body_size": 10485760,
    "max_file_size": 134217728,
