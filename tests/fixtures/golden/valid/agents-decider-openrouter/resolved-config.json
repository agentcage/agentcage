  "container": {
    "add_capabilities": [],
    "build": {
      "args": {},
      "containerfile": ""
    },
    "command": [
      "node",
      "/app/agent.js"
    ],
    "cpus": "",
    "drop_capabilities": [
      "ALL"
    ],
    "env": {},
    "image": "docker.io/library/node:22-slim",
    "memory": "",
    "named_volumes": {},
    "nested_containers": false,
    "no_new_privileges": true,
    "podman_secrets": [],
    "ports": [],
    "read_only": true,
    "restart": "on-failure",
    "restart_sec": 10,
    "security_label_disable": true,
    "timeout_start_sec": 120,
    "timeout_stop_sec": 30,
    "tmpfs": [],
    "user": "1000:1000",
    "userns": "",
    "volumes": []
  },
  "dns_servers": [
    "192.0.2.53"
  ],
  "domains": {
    "allow": [
      "api.example.com",
      "cdn.example.com"
    ],
    "block": [],
    "expires": {},
    "mode": "allowlist",
    "passthrough": []
