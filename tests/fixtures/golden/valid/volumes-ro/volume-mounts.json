{
  "mask_copyup_entries": [],
  "mask_mountpoint_dirs": [],
  "mount_targets": [
    [
      "/workspace",
      "${HOME}/workspace"
    ]
  ],
  "tmpfs": [],
  "volumes": [
    {
      "non_persistent": false,
      "options": [
        "ro"
      ],
      "raw_options": "ro",
      "source": "${HOME}/workspace",
      "spec": "${HOME}/workspace:/workspace:ro",
      "target": "/workspace"
    }
  ]
}
