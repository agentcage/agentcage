[Unit]
Description=agentcage cage
Requires=tmpfs-mask-copyup-egress.service
After=tmpfs-mask-copyup-egress.service

[Container]
ContainerName=tmpfs-mask-copyup-cage
Image=docker.io/library/node:22-slim
Network=tmpfs-mask-copyup-net.network:ip=10.89.225.2
Environment="HTTP_PROXY=http://10.89.225.10:8080"
Environment="HTTPS_PROXY=http://10.89.225.10:8080"
Environment="http_proxy=http://10.89.225.10:8080"
Environment="https_proxy=http://10.89.225.10:8080"
Environment="NODE_EXTRA_CA_CERTS=/certs/mitmproxy-ca-cert.pem"
Environment="SSL_CERT_FILE=/certs/mitmproxy-ca-cert.pem"
Environment="AGENTCAGE_VERSION=0.0.0-golden"
Volume=tmpfs-mask-copyup-public-certs.volume:/certs:ro,Z
Volume={{WORK}}/patches/resolv-tmpfs-mask-copyup.conf:/etc/resolv.conf:ro,Z
Volume={{HOME}}/project:/workspace:rw
Tmpfs=/workspace/.claude:rw,tmpcopyup,mode=1777
User=1000:1000
ReadOnly=true
SecurityLabelDisable=true
NoNewPrivileges=true
DropCapability=ALL
Exec=node /app/agent.js

[Service]
# tmpfs masks (#170/#173) whose target lives under a host bind-mount force the
# OCI runtime to create the mount point, and a bind shares inodes with its
# source, so the mkdir lands in the operator's project directory on the host —
# a non-git project gains a stray `.git/hooks/` that `test -d .git` misreads as
# a repository (#320). The masks stay unconditional; instead, record here which
# of those paths were absent immediately before start, then remove exactly
# those on teardown and only while they are still empty. Host paths are
# base64-encoded because a systemd Exec line applies its own quoting before
# bash does, and no single escaping of `~/My Project` survives both layers.
ExecStartPre=/bin/bash -c 'mkdir -p %t/agentcage/tmpfs-mask-copyup/masks && : > %t/agentcage/tmpfs-mask-copyup/masks/root-0 && echo e3tIT01FfX0vcHJvamVjdC8uY2xhdWRlCg== | base64 -d | while IFS= read -r d; do [ -n "$d" ] || continue; [ -e "$d" ] && continue; [ -L "$d" ] && continue; echo "$d" >> %t/agentcage/tmpfs-mask-copyup/masks/root-0; done'
# Deepest path first, so `<project>/.git/hooks` is retired before the
# `<project>/.git` parent the same mask created. `rmdir` is the whole safety
# story for "only if empty"; the realpath containment check keeps a symlink
# swapped in after start from redirecting a removal outside the bind root, and
# never-recorded (pre-existing) directories are simply not in the list.
ExecStopPost=-/bin/bash -c 'f=%t/agentcage/tmpfs-mask-copyup/masks/root-0; [ -f "$f" ] || exit 0; root=$(echo e3tIT01FfX0vcHJvamVjdA== | base64 -d) && root=$(realpath -m -- "$root") || exit 0; while IFS= read -r d; do [ -n "$d" ] || continue; case "$(realpath -m -- "$d")" in "$root"/*) ;; *) continue ;; esac; [ -L "$d" ] && continue; [ -d "$d" ] || continue; rmdir "$d" 2>/dev/null || echo "agentcage: keeping $d (created as a tmpfs mask mount point, but not empty)" >&2; done < "$f"; rm -f "$f"; exit 0'
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do podman exec tmpfs-mask-copyup-egress test -f /home/acproxy/.mitmproxy/mitmproxy-ca-cert.pem && exit 0; sleep 1; done; echo "Timed out waiting for CA cert"; exit 1'
# A tmpfs mask that opted into `tmpcopyup` (#328) comes up already holding a
# copy of what it covers — but the runtime performs that copy as the user-
# namespace root it mounts as and does not replay the source's ownership, so
# every entry lands `0:0`. The mask's own `mode=1777` (#321) then lets the
# cage's uid create NEW files while modifying or deleting a copied one still
# fails EACCES/EPERM: an agent can read the project's `.claude/settings.json`
# but not edit its own throwaway copy. Hand the copy to the cage user.
#
# This cannot be an ExecStartPre: that runs BEFORE the container, when the
# tmpfs does not exist yet. It also must not be a `podman exec` — the cage
# drops every capability, so root in an exec session has no CAP_CHOWN, and
# `--privileged` would both hand a full capability set to a session running
# the cage IMAGE's own `chown` binary and undercut the cage's threat model
# for a cosmetic fix. `nsenter -U` instead joins only the container's user
# namespace (which this unit's user owns, so it gets a full capability set
# there) and runs the HOST's chown against the container's mount tree via
# /proc/PID/root — the same mechanism the default-route ExecStartPost below
# already relies on. The plain-chown fallback covers a rootful podman with no
# user namespace to join.
#
# `-h` chowns symlinks themselves and `-R` does not traverse them (GNU
# chown's -P default), so a symlink the workload plants inside the mask
# between container start and this hook cannot redirect the chown at a path
# outside it. Only the in-cage tmpfs is touched; the host source the copy
# came from is never chowned.
ExecStartPost=-/bin/bash -c 'd=$(echo L3dvcmtzcGFjZS8uY2xhdWRl | base64 -d) || exit 0; for i in $(seq 1 30); do PID=$(podman inspect --format "{{.State.Pid}}" tmpfs-mask-copyup-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then nsenter -t "$PID" -U -- chown -Rh 1000:1000 "/proc/$PID/root$d" 2>/dev/null && exit 0; chown -Rh 1000:1000 "/proc/$PID/root$d" 2>/dev/null && exit 0; break; fi; sleep 0.5; done; echo "agentcage: could not hand the copy-up tmpfs mask $d to 1000:1000 — the cage can read the seeded content but not edit it" >&2; exit 0'
# Add the cage's default route via the egress container. Retries because
# the container PID is briefly invalid (0/empty) right after `podman start`
# returns and before the container's init has fully populated state.
# Without the retry, the route is silently skipped on a restart, the
# cage has no outbound network, and every fetch from inside the cage
# fails fast with ECONNREFUSED — surfacing as 502s in tests that
# exercise the data path after a domain add or secret set restart.
ExecStartPost=/bin/sh -c 'LAST_ERR=""; for i in $(seq 1 30); do PID=$(podman inspect --format "{{.State.Pid}}" tmpfs-mask-copyup-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then LAST_ERR=$(nsenter -t "$PID" -U -n -- ip route replace default via 10.89.225.10 2>&1) && { echo "added default route via 10.89.225.10 (attempt $i)"; exit 0; }; fi; sleep 0.5; done; echo "WARNING: failed to add cage default route via 10.89.225.10 after 30 attempts: $LAST_ERR" >&2; exit 1'
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
