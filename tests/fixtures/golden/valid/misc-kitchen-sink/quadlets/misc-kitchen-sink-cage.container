[Unit]
Description=agentcage cage
Requires=misc-kitchen-sink-egress.service
After=misc-kitchen-sink-egress.service

[Container]
ContainerName=misc-kitchen-sink-cage
Image=docker.io/library/node:22-slim
Network=misc-kitchen-sink-net.network:ip=10.89.189.2
Environment="HTTP_PROXY=http://10.89.189.10:8080"
Environment="HTTPS_PROXY=http://10.89.189.10:8080"
Environment="http_proxy=http://10.89.189.10:8080"
Environment="https_proxy=http://10.89.189.10:8080"
Environment="NODE_EXTRA_CA_CERTS=/certs/mitmproxy-ca-cert.pem"
Environment="SSL_CERT_FILE=/certs/mitmproxy-ca-cert.pem"
Environment="AGENTCAGE_VERSION=0.0.0-golden"
Volume=misc-kitchen-sink-public-certs.volume:/certs:ro,Z
Volume={{WORK}}/patches/resolv-misc-kitchen-sink.conf:/etc/resolv.conf:ro,Z
Volume={{HOME}}/project:/workspace:rw
Volume={{HOME}}/data:/data:O,upperdir=%t/agentcage/misc-kitchen-sink/mounts/vol-0/upper,workdir=%t/agentcage/misc-kitchen-sink/mounts/vol-0/work
Volume=state:/var/lib/state:rw
Tmpfs=/tmp:rw,noexec,nosuid,size=64M
Tmpfs=/workspace/.git/hooks:rw,noexec,nosuid,nodev,size=64M,notmpcopyup,mode=1777
Environment="NODE_ENV=production"
EnvironmentFile={{XDG_CONFIG_HOME}}/agentcage/cages/misc-kitchen-sink/cage-env/placeholders.env
Volume={{XDG_CONFIG_HOME}}/agentcage/cages/misc-kitchen-sink/cage-env:/run/agentcage/env:ro,Z
UserNS=keep-id
User=1000:1000
SecurityLabelDisable=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=2g
PodmanArgs=--cpus=2
Exec=node /app/agent.js

[Service]
# Reset stale overlay state before every start (including recovery after an
# unclean stop), then remove it again once the container has stopped.
ExecStartPre=/bin/bash -c 'rm -rf %t/agentcage/misc-kitchen-sink/mounts && mkdir -p %t/agentcage/misc-kitchen-sink/mounts/vol-0/upper %t/agentcage/misc-kitchen-sink/mounts/vol-0/work'
ExecStopPost=/bin/bash -c 'rm -rf %t/agentcage/misc-kitchen-sink/mounts'
# tmpfs masks (#170/#173) whose target lives under a host bind-mount force the
# OCI runtime to create the mount point, and a bind shares inodes with its
# source, so the mkdir lands in the operator's project directory on the host —
# a non-git project gains a stray `.git/hooks/` that `test -d .git` misreads as
# a repository (#320). The masks stay unconditional; instead, record here which
# of those paths were absent immediately before start, then remove exactly
# those on teardown and only while they are still empty. Host paths are
# base64-encoded because a systemd Exec line applies its own quoting before
# bash does, and no single escaping of `~/My Project` survives both layers.
ExecStartPre=/bin/bash -c 'mkdir -p %t/agentcage/misc-kitchen-sink/masks && : > %t/agentcage/misc-kitchen-sink/masks/root-0 && echo e3tIT01FfX0vcHJvamVjdC8uZ2l0L2hvb2tzCnt7SE9NRX19L3Byb2plY3QvLmdpdAo= | base64 -d | while IFS= read -r d; do [ -n "$d" ] || continue; [ -e "$d" ] && continue; [ -L "$d" ] && continue; echo "$d" >> %t/agentcage/misc-kitchen-sink/masks/root-0; done'
# Deepest path first, so `<project>/.git/hooks` is retired before the
# `<project>/.git` parent the same mask created. `rmdir` is the whole safety
# story for "only if empty"; the realpath containment check keeps a symlink
# swapped in after start from redirecting a removal outside the bind root, and
# never-recorded (pre-existing) directories are simply not in the list.
ExecStopPost=-/bin/bash -c 'f=%t/agentcage/misc-kitchen-sink/masks/root-0; [ -f "$f" ] || exit 0; root=$(echo e3tIT01FfX0vcHJvamVjdA== | base64 -d) && root=$(realpath -m -- "$root") || exit 0; while IFS= read -r d; do [ -n "$d" ] || continue; case "$(realpath -m -- "$d")" in "$root"/*) ;; *) continue ;; esac; [ -L "$d" ] && continue; [ -d "$d" ] || continue; rmdir "$d" 2>/dev/null || echo "agentcage: keeping $d (created as a tmpfs mask mount point, but not empty)" >&2; done < "$f"; rm -f "$f"; exit 0'
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do podman exec misc-kitchen-sink-egress test -f /home/acproxy/.mitmproxy/mitmproxy-ca-cert.pem && exit 0; sleep 1; done; echo "Timed out waiting for CA cert"; exit 1'
# Add the cage's default route via the egress container. Retries because
# the container PID is briefly invalid (0/empty) right after `podman start`
# returns and before the container's init has fully populated state.
# Without the retry, the route is silently skipped on a restart, the
# cage has no outbound network, and every fetch from inside the cage
# fails fast with ECONNREFUSED — surfacing as 502s in tests that
# exercise the data path after a domain add or secret set restart.
ExecStartPost=/bin/sh -c 'LAST_ERR=""; for i in $(seq 1 30); do PID=$(podman inspect --format "{{.State.Pid}}" misc-kitchen-sink-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then LAST_ERR=$(nsenter -t "$PID" -U -n -- ip route replace default via 10.89.189.10 2>&1) && { echo "added default route via 10.89.189.10 (attempt $i)"; exit 0; }; fi; sleep 0.5; done; echo "WARNING: failed to add cage default route via 10.89.189.10 after 30 attempts: $LAST_ERR" >&2; exit 1'
Restart=no
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
