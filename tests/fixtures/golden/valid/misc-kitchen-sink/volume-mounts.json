{
  "mask_copyup_entries": [],
  "mask_mountpoint_dirs": [
    "${HOME}/project"
  ],
  "mount_targets": [
    [
      "/workspace",
      "${HOME}/project"
    ],
    [
      "/data",
      ""
    ],
    [
      "/var/lib/state",
      ""
    ]
  ],
  "tmpfs": [
    {
      "enclosing_mount": [
        "",
        ""
      ],
      "options": [
        "rw",
        "noexec",
        "nosuid",
        "size=64M"
      ],
      "spec": "/tmp:rw,noexec,nosuid,size=64M",
      "target": "/tmp",
      "wants_copyup": false
    },
    {
      "enclosing_mount": [
        "/workspace",
        "${HOME}/project"
      ],
      "options": [
        "rw",
        "noexec",
        "nosuid",
        "nodev",
        "size=64M"
      ],
      "spec": "/workspace/.git/hooks:rw,noexec,nosuid,nodev,size=64M",
      "target": "/workspace/.git/hooks",
      "wants_copyup": false
    }
  ],
  "volumes": [
    {
      "non_persistent": false,
      "options": [
        "rw"
      ],
      "raw_options": "rw",
      "source": "${HOME}/project",
      "spec": "${HOME}/project:/workspace:rw",
      "target": "/workspace"
    },
    {
      "non_persistent": true,
      "options": [
        "rw",
        "np"
      ],
      "raw_options": "rw,np",
      "source": "${HOME}/data",
      "spec": "${HOME}/data:/data:rw,np",
      "target": "/data"
    }
  ]
}
