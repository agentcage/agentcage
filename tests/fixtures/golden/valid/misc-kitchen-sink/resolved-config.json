{
  "agents": {
    "decider": {
      "api_key": "systemd-creds:FAKE_DECIDER_KEY",
      "base_url": "",
      "context": "",
      "enable": true,
      "host": "agentcage.local",
      "max_tokens": 8192,
      "model": "claude-fake-1",
      "provider": "anthropic",
      "rate_limit_burst": 5,
      "rate_limit_rps": 1.0,
      "timeout_seconds": 15.0
    },
    "watcher": {
      "api_key": "",
      "auto_revoke": true,
      "base_url": "",
      "context": "",
      "dedup_samples": true,
      "enable": false,
      "interval_seconds": 900.0,
      "max_digest_tokens": 8000,
      "max_flows": 200,
      "max_tokens": 8192,
      "model": "",
      "provider": "",
      "timeout_seconds": 30.0,
      "window_seconds": 3600.0
    }
  },
  "apple_container_autostart": false,
  "capture": {
    "domains": [],
    "enable_har": true,
    "exclude_domains": [],
    "max_body_size": 10485760,
    "max_file_size": 134217728,
    "min_action": "flag"
  },
  "container": {
    "add_capabilities": [],
    "build": {
      "args": {},
      "containerfile": ""
    },
    "command": [
      "node",
      "/app/agent.js"
    ],
    "cpus": "2",
    "drop_capabilities": [
      "ALL"
    ],
    "env": {
      "NODE_ENV": "production"
    },
    "image": "docker.io/library/node:22-slim",
    "memory": "2g",
    "named_volumes": {
      "state": "/var/lib/state:rw"
    },
    "nested_containers": false,
    "no_new_privileges": true,
    "podman_secrets": [],
    "ports": [
      "127.0.0.1:3000:3000"
    ],
    "read_only": false,
    "restart": "on-failure",
    "restart_sec": 10,
    "security_label_disable": true,
    "timeout_start_sec": 120,
    "timeout_stop_sec": 30,
    "tmpfs": [
      "/tmp:rw,noexec,nosuid,size=64M",
      "/workspace/.git/hooks:rw,noexec,nosuid,nodev,size=64M"
    ],
    "user": "1000:1000",
    "userns": "keep-id",
    "volumes": [
      "${HOME}/project:/workspace:rw",
      "${HOME}/data:/data:rw,np"
    ]
  },
  "dns_servers": [
    "192.0.2.53"
  ],
  "domains": {
    "allow": [
      "api.example.com",
      "registry.example.net"
    ],
    "block": [],
    "expires": {},
    "mode": "allowlist",
    "passthrough": [
      "registry.example.net"
    ]
  },
  "exec_aliases": {},
  "help": "",
  "inspectors": [
    {
      "name": "domain"
    },
    {
      "name": "secrets"
    }
  ],
  "isolation": "container",
  "lifecycle": "interactive",
  "logging": {
    "allowed_requests": false,
    "cage": "",
    "dns": "",
    "dns_queries": true,
    "level": "debug",
    "proxy": "",
    "proxy_connections": false
  },
  "name": "misc-kitchen-sink",
  "ports": {
    "icmp": {
      "allow": true
    },
    "tcp": {
      "allow": [
        80,
        443,
        9418
      ],
      "passthrough": [
        9418
      ]
    },
    "udp": {
      "allow": [
        443
      ]
    }
  },
  "protocol_relays": [],
  "scaffold": "",
  "secret_injection": [
    {
      "env": "FAKE_API_KEY",
      "inject_body": false,
      "inject_headers": [],
      "inject_to": [
        "api.example.com"
      ],
      "placeholder": "",
      "source": "systemd-creds:FAKE_API_KEY",
      "transform": "",
      "transform_config": {}
    }
  ],
  "secrets": {
    "allow_plaintext": false,
    "backend": "auto",
    "scope": "auto"
  },
  "vm": {
    "mem_mb": 4096,
    "vcpus": 4
  }
}
