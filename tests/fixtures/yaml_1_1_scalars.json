  "read_side_note": "Documents for the reading half of the boundary. Unlike `cases`, these carry no recorded expectation: rust/agentcage-core/tests/yaml_pyyaml_crossing.rs loads each one with yaml.safe_load AND with agentcage's yaml::load and requires the two to describe the same value, plus the same answer from Python's bool(). Nothing here is a human's guess about what PyYAML does.",
  "read_side_cases": [
    {
      "id": "plain-no",
      "yaml": "tls: no\n",
      "why": "the case the whole read side is about: PyYAML gives False"
    },
    {
      "id": "single-quoted-no",
      "yaml": "tls: 'no'\n",
      "why": "quoted: PyYAML gives the string, and bool('no') is True -- TLS stays ON"
    },
    {
      "id": "double-quoted-no",
      "yaml": "tls: \"no\"\n",
      "why": "same, double quotes"
    },
    {
      "id": "plain-false",
      "yaml": "tls: false\n",
      "why": "the YAML 1.2 spelling, a boolean in both schemas"
    },
    {
      "id": "double-quoted-false",
      "yaml": "tls: \"false\"\n",
      "why": "config.py:1255's trap: bool('false') is True"
    },
    {
      "id": "single-quoted-false",
      "yaml": "tls: 'false'\n",
      "why": "same, single quotes"
    },
    {
      "id": "plain-yes",
      "yaml": "tls: yes\n",
      "why": "1.1 true spelling"
    },
    {
      "id": "plain-on",
      "yaml": "tls: on\n",
      "why": "1.1 true spelling"
    },
    {
      "id": "plain-off",
      "yaml": "tls: off\n",
      "why": "1.1 false spelling"
    },
    {
      "id": "plain-Off",
      "yaml": "tls: Off\n",
      "why": "title case"
    },
    {
      "id": "plain-NO",
      "yaml": "tls: NO\n",
      "why": "upper case"
    },
    {
      "id": "plain-ON",
      "yaml": "tls: ON\n",
      "why": "upper case"
    },
    {
      "id": "tagged-str-no",
      "yaml": "tls: !!str no\n",
      "why": "an explicit tag beats the resolver: a plain scalar that is still a string"
    },
    {
      "id": "literal-block-no",
      "yaml": "tls: |-\n  no\n",
      "why": "a block scalar is never plain"
    },
    {
      "id": "folded-block-no",
      "yaml": "tls: >-\n  no\n",
      "why": "folded style, likewise"
    },
    {
