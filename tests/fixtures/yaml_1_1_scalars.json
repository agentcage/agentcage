{
  "contract": "yaml_1_1_plain_scalars",
  "summary": "Plain (unquoted) YAML scalars where PyYAML's YAML 1.1 resolver and every Rust crate's YAML 1.2 resolver disagree, plus the near misses that prove the rule is a pattern and not a word list.",
  "why_this_file_exists": [
    "The host writes proxy-config.yaml; the egress proxy reads it with yaml.safe_load.",
    "PyYAML is YAML 1.1: a plain `no` is False, `1:30` is 90, `2024-01-02` is a date, `<<` raises.",
    "Every Rust YAML crate is YAML 1.2, where all of those are strings, so it emits them unquoted.",
    "PyYAML quotes 'no' on output, so Python->Rust and Python->Python are safe. Only Rust->Python corrupts.",
    "A Rust round-trip test therefore passes while the bug is live. The crossing test has to run real PyYAML."
  ],
  "implementations": {
    "host": "agentcage-core `yaml::is_yaml_1_1_ambiguous` (rust/agentcage-core/src/yaml/pyyaml.rs), which transliterates PyYAML's implicit-resolver table",
    "proxy": "PyYAML's own yaml.resolver.Resolver, as shipped in the egress image"
  },
  "oracle": {
    "plain_tag": "yaml.resolver.Resolver().resolve(yaml.ScalarNode, scalar, (True, False)), with the tag:yaml.org,2002: prefix stripped",
    "note": "Every expectation in this file is re-derived from the running PyYAML by rust/agentcage-core/tests/yaml_pyyaml_crossing.rs before it is used, so the file cannot rot against a PyYAML upgrade without the test saying so. Recording it anyway keeps the corpus readable in a diff and lets the pure-Rust tests assert against it without Python."
  },
  "fields": {
    "id": "stable anchor a diff is read against",
    "scalar": "the exact text, as a JSON string",
    "why": "what this case is for; a deliberate adversarial case reads differently from noise",
    "plain_tag": "the YAML tag PyYAML resolves this text to when it appears PLAIN. Anything other than \"str\" means agentcage's emitter must quote it."
  },
  "counts": {
    "cases": 104,
    "resolve_to_non_string_when_plain": 56,
    "by_tag": {
      "bool": 18,
      "float": 10,
      "int": 15,
      "merge": 1,
      "null": 5,
      "str": 48,
      "timestamp": 6,
      "value": 1
    },
    "read_side_cases": 28
  },
