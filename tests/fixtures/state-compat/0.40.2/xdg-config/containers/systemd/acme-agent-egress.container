[Unit]
Description=agentcage egress (mitmproxy + dnsmasq)

[Container]
ContainerName=acme-agent-egress
Image=localhost/agentcage-egress:0.40.2
Network=acme-agent-net.network:ip=10.89.137.10
Network=podman
# mitmproxy resolves allowlisted upstream hostnames via this file (it
# re-resolves the SNI/Host on the upstream connection — empirically
# confirmed: breaking only this resolver 502s every allowlisted host even
# when the cage itself resolved fine). services.write_resolv_files seeds it
# with config.dns_servers; supervisor-egress.sh then PREPENDS the egress's
# default-route gateway as the primary nameserver (host-tracking — on
# netavark that gateway is aardvark, which forwards to the host's CURRENT
# resolver), keeping dns_servers as fallback. This makes mitmproxy track
# host network changes with no restart, matching the apple-container egress
# (whose resolv.conf is the vmnet gateway). getaddrinfo checks /etc/hosts
# FIRST, so the e2e upstream mock is unaffected by the nameserver order.
#
# Historical note: an earlier version pinned this to dns_servers ONLY,
# avoiding aardvark over a feared "wins resolv.conf ordering then
# intermittently fails to forward → 502" race. That race did NOT reproduce
# under heavy create/destroy churn (600+ queries, 0 failures, verified in
# Lima on aardvark 1.4.0), and here the gateway is the PRIMARY with
# dns_servers as a deterministic fallback, so a transient gateway hiccup
# falls through instead of 502ing. Bind is rw so the supervisor can prepend.
Volume=/home/agentcage-fixture/.local/share/agentcage/patches/resolv-egress-acme-agent.conf:/etc/resolv.conf:rw,Z
Volume=/home/agentcage-fixture/.config/agentcage/cages/acme-agent/proxy-config.yaml:/etc/agentcage/config.yaml:ro,Z
Volume=/home/agentcage-fixture/.config/agentcage/cages/acme-agent/dns-allowlist.conf:/etc/agentcage/dns-allowlist.conf:ro,Z
Environment="PYTHONUNBUFFERED=1"
Environment="AGENTCAGE_VERSION=0.40.2"
# Upstream resolvers for policy-api granted zones. The supervisor
# forwards a granted zone here (plus the default-route gateway when
# derivable) rather than scraping the rendered baseline — under full
# default-deny that baseline is EMPTY, and a grant must still resolve.
Environment="AGENTCAGE_DNS_UPSTREAMS=1.1.1.1 9.9.9.9"
Volume=acme-agent-certs.volume:/home/acproxy/.mitmproxy:Z
# Public-only cert publish dir — see quadlets.py for why this is a
# separate volume. supervisor-egress.sh Step E installs the public
# CA cert here after mitmproxy generates it; the cage's /certs:ro
# bind reads from this volume (NOT the private-key volume above).
Volume=acme-agent-public-certs.volume:/home/acproxy/public-certs:Z
Volume=/home/agentcage-fixture/.local/share/agentcage/acme-agent/capture:/var/log/agentcage/capture:Z
Environment="AGENTCAGE_CAPTURE=/var/log/agentcage/capture/capture.jsonl"
# agents grants overlay — shared between the egress addon (which
# writes decided grants here) and the host-side grants watcher (which reads
# them and promotes into the static baseline via the ``domain add`` chain).
# RW + acproxy-owned so the addon can write; the cage is in a separate
# netns and cannot read it. On container/apple backends this is the host
# dir state.grants_file(name) points at; on the vm backend it is a
# VM-LOCAL dir (quadlets.vm_local_grants_dir — Lima mounts can't be
# trusted for host↔guest rewrites), round-tripped by the host watcher
# via limactl (backends.vm.pull_grants / push_grants).
Volume=/home/agentcage-fixture/.local/share/agentcage/acme-agent/grants:/var/lib/agentcage:Z
Environment="AGENTCAGE_GRANTS_DIR=/var/lib/agentcage"
AddCapability=NET_ADMIN
AddCapability=NET_BIND_SERVICE
# SETUID + SETGID + SETPCAP: the supervisor uses ``setpriv
# --reuid=acdns --regid=acdns --bounding-set=-all,+net_bind_service``
# for dnsmasq and ``--reuid=acproxy --regid=acproxy --bounding-set=-all
# --no-new-privs`` for mitmproxy.
#   * setresuid/setresgid need CAP_SETUID / CAP_SETGID
#   * --bounding-set drops bits from the bounding set, which needs
#     CAP_SETPCAP
# On default rootless podman these three are in the default cap set,
# but `containers.conf` with ``default_capabilities = []`` (hardened
# deployments) drops them — then setpriv fails with "Operation not
# permitted" and the supervisor exits before either daemon binds its
# port. Explicit AddCapability= makes the Quadlet authoritative across
# both default and hardened podman configs.
AddCapability=SETUID
AddCapability=SETGID
AddCapability=SETPCAP
# KILL: the supervisor (PID 1 of the egress container, root in the
# user namespace) polls dnsmasq + mitmproxy via ``kill -0 "$pid"``
# (step C, step E, the monitor loop). Both daemons run as non-root
# (acdns=201, acproxy=200) after setpriv drops privileges, so a uid-0
# → uid-201 signal needs either matching uid OR CAP_KILL. On default
# rootless podman CAP_KILL is in the default cap set; on hardened
# ``default_capabilities = []`` setups it isn't, and every kill -0
# returns EPERM — the supervisor mistakenly reports both daemons as
# "exited before binding", the monitor loop exits 1 on the first
# iteration, and the egress container restarts in a tight loop.
AddCapability=KILL
Sysctl=net.ipv4.ip_unprivileged_port_start=80
# ip_forward enabled at create time — rootless podman doesn't grant
# CAP_SYS_ADMIN even with --cap-add net_admin, so the supervisor cannot
# `sysctl -w` it from inside. The egress is a router between the cage
# netns and the host bridge: without ip_forward the FORWARD chain is
# unreachable for passthrough_tcp_ports / allow_udp_ports.
Sysctl=net.ipv4.ip_forward=1
# Port-policy plumbing: the three lists come from cage.yaml's ``ports.tcp.allow``
# / ``ports.tcp.passthrough`` / ``ports.udp.allow`` (after the inspected =
# allow − passthrough subtraction in quadlets._effective_port_policy). The
# supervisor reads these env vars and emits one iptables rule per port —
# REDIRECT to mitmproxy for INSPECTED_TCP_PORTS, ACCEPT in FORWARD for
# PASSTHROUGH_TCP_PORTS and ALLOW_UDP_PORTS. Always rendered (even when a
# list is empty) so the supervisor can distinguish "use defaults" from
# "intentionally none" — pre-fix the supervisor's hard-coded ``80 443``
# default masked an empty / non-default cage.yaml policy.
Environment="INSPECTED_TCP_PORTS=80 443 993"
Environment="PASSTHROUGH_TCP_PORTS="
Environment="ALLOW_UDP_PORTS="
# Outbound ICMP echo-request (`ping`) is opt-in via cage.yaml's
# ``ports.icmp.allow`` (default false → "0"). The supervisor installs the
# FORWARD accept rule only when this is "1"; otherwise the default-deny
# policy drops echo-request for every in-cage uid.
Environment="ALLOW_ICMP=0"
# Bind mitmproxy's regular (forward) proxy to the egress's cage-net IP
# only. The egress sits on TWO networks — its own ``acme-agent-net``
# (cage-facing) AND the default ``podman`` network (host-facing, used
# for the egress's own outbound to the internet). The initial v0.22
# supervisor used ``--mode regular@:8080`` (i.e. 0.0.0.0) which let
# any OTHER rootless container on the host's default podman network
# reach this cage's mitmproxy as an open forward proxy via the
# egress's podman-network IP. Pinning the bind to ip_egress closes
# that path and matches what the legacy proxy.container.j2 did.
#
# Residual (out of scope for this fix): a foreign rootless container
# can still reach our cage-net IP via the host's inter-bridge routing,
# and the host MASQUERADEs the source into our cage subnet so an
# INPUT-chain source filter doesn't catch it. The legacy 3-service
# proxy had the same residual. Tracked separately — see the
# corresponding note in supervisor-egress.sh.
#
# Transparent mode (8443) still listens on all interfaces but is safe
# in practice because mitmproxy uses SO_ORIGINAL_DST to recover the
# target — a direct connection from a foreign netns has no
# REDIRECT-supplied original dst and the handshake fails.
Environment="AGENTCAGE_REGULAR_BIND=10.89.137.10:8080"
PublishPort=127.0.0.1:18080:3000
# Pass inbound-forward info to the egress supervisor so it adds
# `--mode reverse:http://<ip_cage>:<port>@0.0.0.0:<port>` per forward
# (the legacy proxy.container.j2 did this in its Exec= line). Without
# these env vars the supervisor skips reverse-mode entirely — PublishPort
# exposes the egress's port to the host but nothing listens, breaking
# inbound traffic to the cage.
Environment="AGENTCAGE_INBOUND_PORTS=3000"
Environment="AGENTCAGE_CAGE_IP=10.89.137.2"
Secret=acme-agent.ANTHROPIC_API_KEY,type=env,target=ANTHROPIC_API_KEY
Secret=acme-agent.GITHUB_TOKEN,type=env,target=GITHUB_TOKEN
Secret=acme-agent.IMAP_PASSWORD,type=env,target=IMAP_PASSWORD
Secret=acme-agent.OPENROUTER_API_KEY,type=env,target=OPENROUTER_API_KEY
Volume=%t/agentcage/acme-agent/secrets:/home/acproxy/secrets:ro,Z

[Service]
ExecStartPre=/bin/bash -o pipefail -c 'podman secret rm "acme-agent.ANTHROPIC_API_KEY" 2>/dev/null || true; systemd-creds --user decrypt --name "ANTHROPIC_API_KEY" "/home/agentcage-fixture/.config/agentcage/cages/acme-agent/creds/ANTHROPIC_API_KEY.cred" - | podman secret create "acme-agent.ANTHROPIC_API_KEY" -'
ExecStartPre=/bin/bash -o pipefail -c 'podman secret rm "acme-agent.IMAP_PASSWORD" 2>/dev/null || true; systemd-creds --user decrypt --name "IMAP_PASSWORD" "/home/agentcage-fixture/.config/agentcage/cages/acme-agent/creds/IMAP_PASSWORD.cred" - | podman secret create "acme-agent.IMAP_PASSWORD" -'
ExecStartPre=/bin/bash -o pipefail -c 'podman secret rm "acme-agent.OPENROUTER_API_KEY" 2>/dev/null || true; systemd-creds --user decrypt --name "OPENROUTER_API_KEY" "/home/agentcage-fixture/.config/agentcage/cages/acme-agent/creds/OPENROUTER_API_KEY.cred" - | podman secret create "acme-agent.OPENROUTER_API_KEY" -'
ExecStartPre=/bin/bash -c 'umask 077; mkdir -p "%t/agentcage/acme-agent/secrets"'
ExecStartPre=-/bin/bash -c 'podman unshare chown -R 0:0 "%t/agentcage/acme-agent/secrets"'
ExecStartPre=-/bin/bash -c 'umask 077; f="%t/agentcage/acme-agent/secrets/ANTHROPIC_API_KEY"; if v=$(podman secret inspect --showsecret --format "{{.SecretData}}" "acme-agent.ANTHROPIC_API_KEY" 2>/dev/null); then printf %%s "$v" > "$f"; else rm -f "$f"; fi'
ExecStartPre=-/bin/bash -c 'umask 077; f="%t/agentcage/acme-agent/secrets/GITHUB_TOKEN"; if v=$(podman secret inspect --showsecret --format "{{.SecretData}}" "acme-agent.GITHUB_TOKEN" 2>/dev/null); then printf %%s "$v" > "$f"; else rm -f "$f"; fi'
ExecStartPre=-/bin/bash -c 'umask 077; f="%t/agentcage/acme-agent/secrets/IMAP_PASSWORD"; if v=$(podman secret inspect --showsecret --format "{{.SecretData}}" "acme-agent.IMAP_PASSWORD" 2>/dev/null); then printf %%s "$v" > "$f"; else rm -f "$f"; fi'
ExecStartPre=-/bin/bash -c 'umask 077; f="%t/agentcage/acme-agent/secrets/OPENROUTER_API_KEY"; if v=$(podman secret inspect --showsecret --format "{{.SecretData}}" "acme-agent.OPENROUTER_API_KEY" 2>/dev/null); then printf %%s "$v" > "$f"; else rm -f "$f"; fi'
ExecStartPre=-/bin/bash -c 'podman unshare chown -R 200:200 "%t/agentcage/acme-agent/secrets"'
ExecStartPre=/bin/bash -c 'mp=$(podman volume inspect agentcage-certs-acme-agent --format "{{.Mountpoint}}") && podman unshare chown 200:200 "$mp"'
ExecStartPre=/bin/bash -c 'podman unshare chown 200:200 "/home/agentcage-fixture/.local/share/agentcage/acme-agent/capture" 2>/dev/null || chmod 1777 "/home/agentcage-fixture/.local/share/agentcage/acme-agent/capture"'
# The grants overlay dir is a TRUE DUAL-WRITER across the rootless user
# namespace: the egress addon (container uid 200, mapped to a subuid on the
# host — egress sets no UserNS=) writes grants.yaml when the decider grants
# a domain, AND the host watcher (the operator) rewrites grants.yaml on
# every tick to remove promoted entries. Both use atomic temp+rename
# (save_grants), so only DIRECTORY write+execute matters; the file's own
# owner/perms are irrelevant. The operator owns the dir (state.grants_dir
# mkdirs it).
#
# Write access is granted to EXACTLY the two legitimate writers — the
# operator (dir owner) and the container's mapped gid — using rootless
# podman's user-namespace mapping: ``podman unshare chgrp 200`` runs chgrp
# INSIDE the container's user namespace, so in-container gid 200 maps to the
# host subgid that the addon's gid maps to, and the host-side dir's group
# becomes that mapped gid. ``chmod 0770`` then gives the operator (owner)
# rwx and the container process (group = mapped gid) rwx; every other local
# user gets nothing. We chgrp (not chown) so the operator stays the owner
# and the watcher can still remove promoted entries (chowning to 200 would
# make the operator "other" and grants would pile up forever).
#
# THREAT MODEL: on a multi-user host the grants dir must NOT be world-
# writable. A local user who can write the dir can plant grants.yaml entries
# that the operator's watcher promotes into the baseline config within ~1s,
# forging the audit trail. The operator-owned baseline (~/.config/agentcage)
# is NOT writable by such a user, so the previous "an attacker who can write
# here can already edit the baseline directly" justification was FALSE. 0770
# closes that path: only operator + mapped container gid can write. If
# ``podman unshare chgrp`` is unavailable (no userns mapping, e.g. a
# stripped/non-rootless podman) the fallback opens the dir 0777 so the
# feature still works on single-user hosts — and warns to stderr so a
# multi-user host operator notices. The cage itself can't reach the dir
# (separate netns).
ExecStartPre=/bin/bash -c 'podman unshare chgrp 200 "/home/agentcage-fixture/.local/share/agentcage/acme-agent/grants" 2>/dev/null && chmod 0770 "/home/agentcage-fixture/.local/share/agentcage/acme-agent/grants" || { echo "agentcage: WARN: podman unshare chgrp failed for grants dir /home/agentcage-fixture/.local/share/agentcage/acme-agent/grants — falling back to 0777 (multi-user hosts: grants.yaml forge risk)" >&2; chmod 0777 "/home/agentcage-fixture/.local/share/agentcage/acme-agent/grants"; }'
Restart=on-failure

[Install]
WantedBy=default.target
