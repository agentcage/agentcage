[Unit]
Description=agentcage cage
Requires=acme-agent-egress.service
After=acme-agent-egress.service

[Container]
ContainerName=acme-agent-cage
Image=docker.io/library/node:22-slim
Network=acme-agent-net.network:ip=10.89.137.2
Environment="HTTP_PROXY=http://10.89.137.10:8080"
Environment="HTTPS_PROXY=http://10.89.137.10:8080"
Environment="http_proxy=http://10.89.137.10:8080"
Environment="https_proxy=http://10.89.137.10:8080"
Environment="NODE_EXTRA_CA_CERTS=/certs/mitmproxy-ca-cert.pem"
Environment="SSL_CERT_FILE=/certs/mitmproxy-ca-cert.pem"
Environment="AGENTCAGE_VERSION=0.40.2"
Volume=acme-agent-public-certs.volume:/certs:ro,Z
Volume=/home/agentcage-fixture/.local/share/agentcage/patches/resolv-acme-agent.conf:/etc/resolv.conf:ro,Z
Volume=/home/agentcage-fixture/workspace/src:/workspace:rw
Volume=/home/agentcage-fixture/workspace/ro-assets:/assets:ro
Volume=acme-agent-npm:/home/node/.npm:rw
Tmpfs=/tmp:rw,noexec,nosuid,size=64M
Environment="NODE_ENV=production"
Environment="AGENT_PROFILE=fixture"
EnvironmentFile=/home/agentcage-fixture/.config/agentcage/cages/acme-agent/cage-env/placeholders.env
Volume=/home/agentcage-fixture/.config/agentcage/cages/acme-agent/cage-env:/run/agentcage/env:ro,Z
User=1000:1000
ReadOnly=true
SecurityLabelDisable=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=4g
PodmanArgs=--cpus=2.0
Exec=node /app/agent.js

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do podman exec acme-agent-egress test -f /home/acproxy/.mitmproxy/mitmproxy-ca-cert.pem && exit 0; sleep 1; done; echo "Timed out waiting for CA cert"; exit 1'
# Add the cage's default route via the egress container. Retries because
# the container PID is briefly invalid (0/empty) right after `podman start`
# returns and before the container's init has fully populated state.
# Without the retry, the route is silently skipped on a restart, the
# cage has no outbound network, and every fetch from inside the cage
# fails fast with ECONNREFUSED — surfacing as 502s in tests that
# exercise the data path after a domain add or secret set restart.
ExecStartPost=/bin/sh -c 'LAST_ERR=""; for i in $(seq 1 30); do PID=$(podman inspect --format "{{.State.Pid}}" acme-agent-cage 2>/dev/null); if [ -n "$PID" ] && [ "$PID" != "0" ]; then LAST_ERR=$(nsenter -t "$PID" -U -n -- ip route replace default via 10.89.137.10 2>&1) && { echo "added default route via 10.89.137.10 (attempt $i)"; exit 0; }; fi; sleep 0.5; done; echo "WARNING: failed to add cage default route via 10.89.137.10 after 30 attempts: $LAST_ERR" >&2; exit 1'
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=default.target
